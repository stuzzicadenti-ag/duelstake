<%- include('../partials/head', { title: 'Leaderboard' }) %>
<%- include('../partials/nav') %>

<div class="container">
  <div class="page-header">
    <h1>&#127942; Leaderboard</h1>
    <p>Top 50 players ranked by global ELO rating.</p>
  </div>

  <!-- Game filter tabs -->
  <div class="tabs" style="overflow-x: auto; flex-wrap: nowrap; -webkit-overflow-scrolling: touch;">
    <a href="/leaderboard" class="tab active" style="white-space: nowrap;">Global</a>
    <% games.forEach(function(g) { %>
      <a href="/leaderboard/<%= g.slug %>" class="tab" style="white-space: nowrap;"><%= g.icon %> <%= g.name %></a>
    <% }); %>
  </div>

  <% if (players.length > 0) { %>
    <div class="card animate-in">
      <div class="table-wrap">
        <table class="lb-table">
          <thead>
            <tr>
              <th style="width: 60px;">#</th>
              <th>Player</th>
              <th>ELO</th>
              <th class="hide-mobile">Wins</th>
              <th class="hide-mobile">Losses</th>
              <th>Win Rate</th>
              <th class="hide-mobile">Best Streak</th>
            </tr>
          </thead>
          <tbody class="stagger-children">
            <% players.forEach(function(p, i) { %>
            <%
              var total = parseInt(p.total_wins) + parseInt(p.total_losses);
              var rate = total > 0 ? ((parseInt(p.total_wins) / total) * 100).toFixed(1) : '0.0';
              var maxElo = 2500;
              var eloPercent = Math.min((parseInt(p.elo_rating) / maxElo) * 100, 100);
            %>
            <tr>
              <td>
                <% if (i === 0) { %>
                  <span class="lb-rank-badge lb-rank-1">&#127942;</span>
                <% } else if (i === 1) { %>
                  <span class="lb-rank-badge lb-rank-2">&#129352;</span>
                <% } else if (i === 2) { %>
                  <span class="lb-rank-badge lb-rank-3">&#129353;</span>
                <% } else { %>
                  <span class="lb-rank-badge lb-rank-default"><%= i + 1 %></span>
                <% } %>
              </td>
              <td>
                <div class="lb-player-info">
                  <span class="lb-player-avatar" style="<%= i < 3 ? 'border-color: ' + (i === 0 ? 'rgba(255,215,0,0.4)' : i === 1 ? 'rgba(192,192,192,0.4)' : 'rgba(205,127,50,0.4)') + '; background: linear-gradient(135deg, ' + (i === 0 ? 'rgba(255,215,0,0.12), rgba(255,170,0,0.06)' : i === 1 ? 'rgba(192,192,192,0.1), rgba(192,192,192,0.04)' : 'rgba(205,127,50,0.1), rgba(205,127,50,0.04)') + ');' : '' %>"><%= (p.display_name || p.username).charAt(0).toUpperCase() %></span>
                  <div>
                    <a href="/profile/<%= p.username %>" style="font-weight: 700; color: var(--text);">
                      <%= p.display_name || p.username %>
                    </a>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">@<%= p.username %></div>
                  </div>
                </div>
              </td>
              <td>
                <div class="lb-elo-bar">
                  <span style="font-weight: 800; font-size: 1.05rem; min-width: 42px;"><%= p.elo_rating %></span>
                  <div style="flex: 1; max-width: 80px; height: 6px; background: var(--surface-2); border-radius: 3px; overflow: hidden;">
                    <div class="lb-elo-fill" style="width: <%= eloPercent %>%;"></div>
                  </div>
                </div>
              </td>
              <td class="hide-mobile" style="color: var(--success); font-weight: 600;"><%= p.total_wins %></td>
              <td class="hide-mobile" style="color: var(--danger); font-weight: 600;"><%= p.total_losses %></td>
              <td>
                <span style="display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; background: rgba(<%= parseFloat(rate) >= 50 ? '34,197,94' : '239,68,68' %>, 0.12); color: var(<%= parseFloat(rate) >= 50 ? '--success' : '--danger' %>);">
                  <%= rate %>%
                </span>
              </td>
              <td class="hide-mobile">
                <% if (parseInt(p.best_streak || 0) > 0) { %>
                  <span style="color: var(--accent); font-weight: 700; display: flex; align-items: center; gap: 4px;">
                    &#128293; <%= p.best_streak %>
                  </span>
                <% } else { %>
                  <span style="color: var(--text-muted);">0</span>
                <% } %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } else { %>
    <div class="empty-state animate-in">
      <div class="icon">&#127942;</div>
      <h2>No players ranked yet</h2>
      <p>Be the first to compete!</p>
      <a href="/games" class="btn btn-primary">Find a Match</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
