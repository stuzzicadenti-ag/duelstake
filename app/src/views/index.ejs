<%- include('partials/head', { title: 'Home' }) %>
<%- include('partials/nav') %>

<div class="container">
  <!-- Hero -->
  <section style="text-align: center; padding: 60px 0 40px;">
    <h1 style="font-size: 3rem; font-weight: 900; letter-spacing: -1px; margin-bottom: 12px;">
      Stake. <span style="color: var(--primary);">Duel.</span> <span style="color: var(--accent);">Win.</span>
    </h1>
    <p style="font-size: 1.2rem; color: var(--text-muted); max-width: 600px; margin: 0 auto 32px;">
      Challenge players in 1v1 matches across your favorite games. Put your skills on the line and earn real rewards.
    </p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/games" class="btn btn-primary" style="padding: 14px 32px; font-size: 1rem;">Find a Match</a>
        <a href="/matches" class="btn btn-secondary" style="padding: 14px 32px; font-size: 1rem;">My Matches</a>
      <% } else { %>
        <a href="/auth/register" class="btn btn-primary" style="padding: 14px 32px; font-size: 1rem;">Get Started</a>
        <a href="/games" class="btn btn-secondary" style="padding: 14px 32px; font-size: 1rem;">Browse Games</a>
      <% } %>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="grid grid-3 mb-4">
    <div class="card stat">
      <div class="stat-value text-primary"><%= activeMatchCount %></div>
      <div class="stat-label">Active Matches</div>
    </div>
    <div class="card stat">
      <div class="stat-value text-accent"><%= games.length %></div>
      <div class="stat-label">Games Available</div>
    </div>
    <div class="card stat">
      <div class="stat-value text-success"><%= topPlayers.length %>+</div>
      <div class="stat-label">Players</div>
    </div>
  </section>

  <!-- Featured Games -->
  <section class="mb-4">
    <div class="flex items-center justify-between mb-2">
      <h2 style="font-size: 1.3rem; font-weight: 700;">Featured Games</h2>
      <a href="/games" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div class="grid grid-3">
      <% games.forEach(function(game) { %>
        <a href="/games/<%= game.slug %>" class="card" style="text-decoration: none; color: var(--text);">
          <div style="font-size: 2.5rem; margin-bottom: 12px;"><%= game.icon %></div>
          <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 6px;"><%= game.name %></h3>
          <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 12px;"><%= game.description %></p>
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <span style="color: var(--accent); font-size: 0.85rem; font-weight: 600;">
              &euro;<%= game.min_stake %> - &euro;<%= game.max_stake %>
            </span>
            <span class="btn btn-primary btn-sm">Play</span>
          </div>
        </a>
      <% }); %>
    </div>
  </section>

  <!-- Top Players -->
  <% if (topPlayers.length > 0) { %>
  <section class="mb-4">
    <div class="flex items-center justify-between mb-2">
      <h2 style="font-size: 1.3rem; font-weight: 700;">Top Players</h2>
      <a href="/leaderboard" class="btn btn-secondary btn-sm">Full Leaderboard</a>
    </div>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Player</th>
              <th>ELO</th>
            </tr>
          </thead>
          <tbody>
            <% topPlayers.forEach(function(p, i) { %>
            <tr>
              <td style="font-weight: 700; color: <%= i === 0 ? 'var(--accent)' : 'var(--text-muted)' %>;">
                <%= i + 1 %>
              </td>
              <td>
                <a href="/profile/<%= p.username %>"><%= p.display_name || p.username %></a>
              </td>
              <td style="font-weight: 700;"><%= p.elo_rating %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <% } %>
</div>

<%- include('partials/footer') %>
