<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DuelStake - Competitive Gaming Matchmaking Platform</title>
  <meta name="description" content="Find opponents, set stakes, and prove your skill on DuelStake. The ultimate competitive gaming matchmaking platform for 1v1 duels, tournaments, and ranked ladders.">
  <meta name="keywords" content="competitive gaming, matchmaking, esports, 1v1, tournaments, staking, FIFA, Call of Duty, Fortnite, Valorant">

  <meta property="og:type" content="website">
  <meta property="og:title" content="DuelStake - Find Opponents. Set Stakes. Prove Your Skill.">
  <meta property="og:description" content="The ultimate competitive gaming matchmaking platform. 1v1 duels, tournaments, ranked ladders and more.">
  <meta property="og:site_name" content="DuelStake">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="DuelStake - Find Opponents. Set Stakes. Prove Your Skill.">
  <meta name="twitter:description" content="The ultimate competitive gaming matchmaking platform. 1v1 duels, tournaments, ranked ladders and more.">
  <meta name="theme-color" content="#ff4136">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/landing.css">
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
  <style>
    .landing-dropdown { position: relative; }
    .landing-dd-menu {
      display: none; position: absolute; top: calc(100% + 4px); right: 0; min-width: 160px;
      background: rgba(22,22,31,0.98); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px; padding: 4px 0; box-shadow: 0 8px 24px rgba(0,0,0,0.4); z-index: 1100;
    }
    .landing-dropdown.open .landing-dd-menu { display: block; }
    .landing-dd-menu a {
      display: block; padding: 8px 16px; color: rgba(255,255,255,0.7); font-size: 0.85rem;
      font-weight: 500; text-decoration: none; transition: color 0.2s, background 0.2s;
    }
    .landing-dd-menu a:hover { color: #fff; background: rgba(255,255,255,0.06); }
    .landing-dd-menu a.active { color: #a78bfa; font-weight: 700; }
  </style>
</head>
<body>

  <nav class="navbar" id="navbar">
    <div class="container nav-container">
      <a href="/" class="nav-logo">
        <span class="logo-icon">&#9876;</span>
        <span class="logo-text">Duel<span class="accent">Stake</span></span>
      </a>
      <input type="checkbox" id="landing-nav-toggle" class="landing-nav-toggle-checkbox" aria-label="Toggle navigation">
      <label for="landing-nav-toggle" class="nav-toggle" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </label>
      <ul class="nav-links" id="navLinks">
        <li><a href="#hero" class="nav-link active"><%= t('nav.home') %></a></li>
        <li><a href="#games" class="nav-link"><%= t('nav.games') %></a></li>
        <li><a href="#tournaments" class="nav-link"><%= t('nav.tournaments') %></a></li>
        <li><a href="#leaderboard" class="nav-link"><%= t('nav.leaderboard') %></a></li>
        <li><a href="#pricing" class="nav-link"><%= t('nav.pricing') %></a></li>
      </ul>
      <div class="nav-actions">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/games" class="btn btn-ghost"><%= t('nav.games') %></a>
          <div class="landing-dropdown" style="position:relative;">
            <button type="button" class="btn btn-ghost landing-dd-btn" style="gap:5px;">
              <%= user.display_name || user.username %> <span style="font-size:0.55rem;">&#9662;</span>
            </button>
            <div class="landing-dd-menu">
              <a href="/matches"><%= t('nav.matches') %></a>
              <a href="/wallet"><%= t('nav.wallet') %></a>
              <a href="/profile/<%= user.username %>"><%= t('nav.profile') || 'Profile' %></a>
              <% if (user.role === 'admin' || user.role === 'owner') { %>
                <a href="/admin" style="color:var(--accent);"><%= t('nav.admin') %></a>
              <% } %>
              <div style="height:1px;background:rgba(255,255,255,0.1);margin:4px 0;"></div>
              <a href="/auth/logout" style="color:var(--danger);"><%= t('nav.logout') %></a>
            </div>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn btn-ghost" id="loginBtn"><%= t('nav.login') %></a>
          <a href="/auth/register" class="btn btn-primary" id="registerBtn"><%= t('nav.register') %></a>
        <% } %>
      </div>
      <div class="landing-dropdown" style="position:relative;">
        <button type="button" class="landing-dd-btn" style="color:rgba(255,255,255,0.7);font-size:0.8rem;font-weight:700;letter-spacing:0.5px;padding:5px 10px;border:none;background:none;cursor:pointer;display:inline-flex;align-items:center;gap:4px;font-family:inherit;">
          <%= (typeof lang !== 'undefined' ? lang : 'en').toUpperCase() %> <span style="font-size:0.55rem;">&#9662;</span>
        </button>
        <div class="landing-dd-menu" style="min-width:100px;">
          <a href="/lang/en" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
          <a href="/lang/it" class="<%= lang === 'it' ? 'active' : '' %>">IT</a>
          <a href="/lang/de" class="<%= lang === 'de' ? 'active' : '' %>">DE</a>
          <a href="/lang/fr" class="<%= lang === 'fr' ? 'active' : '' %>">FR</a>
        </div>
      </div>
    </div>
  </nav>

  <section class="hero" id="hero">
    <div class="hero-bg"></div>
    <div class="container hero-content">
      <div class="hero-badge"><%- t('hero.badge') %></div>
      <h1 class="hero-title">
        <span class="logo-icon-large">&#9876;</span>
        Duel<span class="accent">Stake</span>
      </h1>
      <p class="hero-tagline"><%- t('hero.tagline') %></p>
      <p class="hero-sub"><%- t('hero.sub') %></p>
      <div class="hero-cta">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/games" class="btn btn-primary btn-lg"><%- t('hero.find_match') %></a>
          <a href="/matches" class="btn btn-outline btn-lg"><%- t('hero.my_matches') %></a>
        <% } else { %>
          <a href="/auth/register" class="btn btn-primary btn-lg"><%- t('hero.start_competing') %></a>
          <a href="/games" class="btn btn-outline btn-lg"><%- t('hero.browse_games') %></a>
        <% } %>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-number"><%= activeMatchCount %></span>
          <span class="stat-label"><%- t('hero.active_matches') %></span>
        </div>
        <div class="stat">
          <span class="stat-number"><%= games.length %></span>
          <span class="stat-label"><%- t('hero.games_available') %></span>
        </div>
        <div class="stat">
          <span class="stat-number"><%= topPlayers.length %>+</span>
          <span class="stat-label"><%- t('hero.top_players') %></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="games">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title"><%- t('home.featured_games') %> <span class="accent"><%- t('home.featured_games_accent') %></span></h2>
        <p class="section-sub"><%- t('home.featured_games_sub') %></p>
      </div>
      <% if (games.length > 0) { %>
        <div class="games-grid">
          <% games.forEach(function(game) { %>
            <div class="game-card">
              <div class="game-icon"><%= game.icon %></div>
              <h3 class="game-title"><%= game.name %></h3>
              <div class="game-meta">
                <span class="game-players">&#128101; <%= game.player_count || 0 %> <%= t('home.online') %></span>
                <span class="game-stakes">&#9876; &euro;<%= game.min_stake %> - &euro;<%= game.max_stake %></span>
              </div>
              <a href="/games/<%= game.slug %>" class="btn btn-primary btn-sm"><%- t('home.find_match') %></a>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="games-grid">
          <div class="game-card">
            <div class="game-icon">&#9917;</div>
            <h3 class="game-title">FIFA 26</h3>
            <div class="game-meta">
              <span class="game-players">&#128101; 12.4K <%= t('home.online') %></span>
              <span class="game-stakes">&#9876; &#8364;1 - &#8364;500</span>
            </div>
            <a href="/games" class="btn btn-primary btn-sm"><%- t('home.find_match') %></a>
          </div>
          <div class="game-card">
            <div class="game-icon">&#128163;</div>
            <h3 class="game-title">Battlefield 6</h3>
            <div class="game-meta">
              <span class="game-players">&#128101; 8.7K <%= t('home.online') %></span>
              <span class="game-stakes">&#9876; &#8364;2 - &#8364;250</span>
            </div>
            <a href="/games" class="btn btn-primary btn-sm"><%- t('home.find_match') %></a>
          </div>
          <div class="game-card">
            <div class="game-icon">&#127919;</div>
            <h3 class="game-title">Call of Duty</h3>
            <div class="game-meta">
              <span class="game-players">&#128101; 15.1K <%= t('home.online') %></span>
              <span class="game-stakes">&#9876; &#8364;1 - &#8364;1000</span>
            </div>
            <a href="/games" class="btn btn-primary btn-sm"><%- t('home.find_match') %></a>
          </div>
          <div class="game-card">
            <div class="game-icon">&#9935;</div>
            <h3 class="game-title">Fortnite</h3>
            <div class="game-meta">
              <span class="game-players">&#128101; 22.3K <%= t('home.online') %></span>
              <span class="game-stakes">&#9876; &#8364;1 - &#8364;300</span>
            </div>
            <a href="/games" class="btn btn-primary btn-sm"><%- t('home.find_match') %></a>
          </div>
          <div class="game-card">
            <div class="game-icon">&#128664;</div>
            <h3 class="game-title">Rocket League</h3>
            <div class="game-meta">
              <span class="game-players">&#128101; 6.9K <%= t('home.online') %></span>
              <span class="game-stakes">&#9876; &#8364;1 - &#8364;200</span>
            </div>
            <a href="/games" class="btn btn-primary btn-sm"><%- t('home.find_match') %></a>
          </div>
          <div class="game-card">
            <div class="game-icon">&#128299;</div>
            <h3 class="game-title">Valorant</h3>
            <div class="game-meta">
              <span class="game-players">&#128101; 18.6K <%= t('home.online') %></span>
              <span class="game-stakes">&#9876; &#8364;2 - &#8364;750</span>
            </div>
            <a href="/games" class="btn btn-primary btn-sm"><%- t('home.find_match') %></a>
          </div>
        </div>
      <% } %>
    </div>
  </section>

  <section class="section section-dark" id="how-it-works">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title"><%- t('home.how_title') %> <span class="accent"><%- t('home.how_accent') %></span></h2>
        <p class="section-sub"><%- t('home.how_sub') %></p>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">01</div>
          <div class="step-icon">&#128100;</div>
          <h3 class="step-title"><%- t('home.step1_title') %></h3>
          <p class="step-desc"><%- t('home.step1_desc') %></p>
        </div>
        <div class="step-card">
          <div class="step-number">02</div>
          <div class="step-icon">&#128269;</div>
          <h3 class="step-title"><%- t('home.step2_title') %></h3>
          <p class="step-desc"><%- t('home.step2_desc') %></p>
        </div>
        <div class="step-card">
          <div class="step-number">03</div>
          <div class="step-icon">&#127942;</div>
          <h3 class="step-title"><%- t('home.step3_title') %></h3>
          <p class="step-desc"><%- t('home.step3_desc') %></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="tournaments">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title"><%- t('home.match_types') %> <span class="accent"><%- t('home.match_types_accent') %></span></h2>
        <p class="section-sub"><%- t('home.match_types_sub') %></p>
      </div>
      <div class="match-types-grid">
        <div class="match-card match-card-featured">
          <div class="match-badge"><%- t('home.most_popular') %></div>
          <div class="match-icon">&#9876;</div>
          <h3 class="match-title"><%- t('home.duels_title') %></h3>
          <p class="match-desc"><%- t('home.duels_desc') %></p>
          <ul class="match-features">
            <li>&#10003; Custom stake amounts</li>
            <li>&#10003; Instant payouts</li>
            <li>&#10003; Skill-based matchmaking</li>
            <li>&#10003; Anti-cheat protected</li>
          </ul>
        </div>
        <div class="match-card">
          <div class="match-icon">&#127942;</div>
          <h3 class="match-title"><%- t('home.tournaments_title') %></h3>
          <p class="match-desc"><%- t('home.tournaments_desc') %></p>
          <ul class="match-features">
            <li>&#10003; Entry fee + prize pool</li>
            <li>&#10003; 8 to 256 players</li>
            <li>&#10003; Multiple formats</li>
            <li>&#10003; Live brackets</li>
          </ul>
        </div>
        <div class="match-card">
          <div class="match-icon">&#128200;</div>
          <h3 class="match-title"><%- t('home.ladders_title') %></h3>
          <p class="match-desc"><%- t('home.ladders_desc') %></p>
          <ul class="match-features">
            <li>&#10003; 100% free to play</li>
            <li>&#10003; XP-based progression</li>
            <li>&#10003; Seasonal rewards</li>
            <li>&#10003; Division tiers</li>
          </ul>
        </div>
        <div class="match-card">
          <div class="match-icon">&#127918;</div>
          <h3 class="match-title"><%- t('home.freeplay_title') %></h3>
          <p class="match-desc"><%- t('home.freeplay_desc') %></p>
          <ul class="match-features">
            <li>&#10003; No stakes required</li>
            <li>&#10003; All games available</li>
            <li>&#10003; Casual matchmaking</li>
            <li>&#10003; Practice mode</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark" id="leaderboard">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title"><%- t('home.top_players') %> <span class="accent"><%- t('home.top_players_accent') %></span></h2>
        <p class="section-sub"><%- t('home.top_players_sub') %></p>
      </div>
      <% if (topPlayers.length > 0) { %>
        <div class="leaderboard-table">
          <div class="leaderboard-row leaderboard-header">
            <span class="lb-rank"><%= t('home.rank') %></span>
            <span class="lb-player"><%= t('home.player') %></span>
            <span class="lb-wins"><%= t('home.elo') %></span>
            <span class="lb-earnings"><%= t('home.profile') %></span>
            <span class="lb-winrate"></span>
          </div>
          <% topPlayers.forEach(function(p, i) { %>
            <div class="leaderboard-row <%= i === 0 ? 'gold' : i === 1 ? 'silver' : i === 2 ? 'bronze' : '' %>">
              <span class="lb-rank"><%= i === 0 ? '&#127941; ' : i === 1 ? '&#129352; ' : i === 2 ? '&#129353; ' : '' %><%= i + 1 %></span>
              <span class="lb-player"><%= p.display_name || p.username %></span>
              <span class="lb-wins"><%= p.elo_rating %></span>
              <span class="lb-earnings"><a href="/profile/<%= p.username %>"><%= t('home.view') %></a></span>
              <span class="lb-winrate"></span>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="leaderboard-table">
          <div class="leaderboard-row leaderboard-header">
            <span class="lb-rank"><%= t('home.rank') %></span>
            <span class="lb-player"><%= t('home.player') %></span>
            <span class="lb-wins"><%= t('home.wins') %></span>
            <span class="lb-earnings"><%= t('home.earnings') %></span>
            <span class="lb-winrate"><%= t('home.winrate') %></span>
          </div>
          <div class="leaderboard-row gold">
            <span class="lb-rank">&#127941; 1</span>
            <span class="lb-player">xDarkSlayer99</span>
            <span class="lb-wins">247</span>
            <span class="lb-earnings">&#8364;12,450</span>
            <span class="lb-winrate">89%</span>
          </div>
          <div class="leaderboard-row silver">
            <span class="lb-rank">&#129352; 2</span>
            <span class="lb-player">NightHawk_Pro</span>
            <span class="lb-wins">231</span>
            <span class="lb-earnings">&#8364;9,820</span>
            <span class="lb-winrate">85%</span>
          </div>
          <div class="leaderboard-row bronze">
            <span class="lb-rank">&#129353; 3</span>
            <span class="lb-player">ShadowBlade_X</span>
            <span class="lb-wins">198</span>
            <span class="lb-earnings">&#8364;8,340</span>
            <span class="lb-winrate">82%</span>
          </div>
          <div class="leaderboard-row">
            <span class="lb-rank">4</span>
            <span class="lb-player">VelocityKing</span>
            <span class="lb-wins">186</span>
            <span class="lb-earnings">&#8364;7,120</span>
            <span class="lb-winrate">79%</span>
          </div>
          <div class="leaderboard-row">
            <span class="lb-rank">5</span>
            <span class="lb-player">IceStorm_GG</span>
            <span class="lb-wins">174</span>
            <span class="lb-earnings">&#8364;6,590</span>
            <span class="lb-winrate">77%</span>
          </div>
        </div>
      <% } %>
      <div style="text-align: center; margin-top: 32px;">
        <a href="/leaderboard" class="btn btn-outline"><%- t('home.view_leaderboard') %></a>
      </div>
    </div>
  </section>

  <section class="section" id="fair-play">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title"><%- t('home.fair_play') %> <span class="accent"><%- t('home.fair_play_accent') %></span></h2>
        <p class="section-sub"><%- t('home.fair_play_sub') %></p>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-icon">&#128247;</div>
          <h3 class="step-title"><%- t('home.proof_title') %></h3>
          <p class="step-desc"><%- t('home.proof_desc') %></p>
        </div>
        <div class="step-card">
          <div class="step-icon">&#129302;</div>
          <h3 class="step-title"><%- t('home.review_title') %></h3>
          <p class="step-desc"><%- t('home.review_desc') %></p>
        </div>
        <div class="step-card">
          <div class="step-icon">&#128274;</div>
          <h3 class="step-title"><%- t('home.verified_title') %></h3>
          <p class="step-desc"><%- t('home.verified_desc') %></p>
        </div>
        <div class="step-card">
          <div class="step-icon">&#9878;</div>
          <h3 class="step-title"><%- t('home.regulated_title') %></h3>
          <p class="step-desc"><%- t('home.regulated_desc') %></p>
        </div>
      </div>
      <div class="fair-play-note">
        <p><%- t('home.payout_note') %></p>
      </div>
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title"><span class="accent"><%- t('home.pricing_accent') %></span> <%- t('home.pricing_title') %></h2>
        <p class="section-sub"><%- t('home.pricing_sub') %></p>
      </div>
      <div class="pricing-grid">
        <div class="pricing-card">
          <div class="pricing-tier"><%- t('home.free') %></div>
          <div class="pricing-price">&#8364;0<span>/mo</span></div>
          <ul class="pricing-features">
            <li>&#10003; 3 matches per day</li>
            <li>&#10003; Leaderboard access</li>
            <li>&#10003; Basic matchmaking</li>
            <li>&#10003; Community chat</li>
            <li class="disabled">&#10007; Priority matchmaking</li>
            <li class="disabled">&#10007; Stats dashboard</li>
            <li class="disabled">&#10007; Team management</li>
          </ul>
          <a href="/auth/register" class="btn btn-outline"><%- t('home.get_started') %></a>
        </div>
        <div class="pricing-card pricing-card-featured">
          <div class="pricing-badge"><%- t('home.best_value') %></div>
          <div class="pricing-tier"><%- t('home.pro') %></div>
          <div class="pricing-price">&#8364;9.99<span>/mo</span></div>
          <ul class="pricing-features">
            <li>&#10003; Unlimited matches</li>
            <li>&#10003; Leaderboard access</li>
            <li>&#10003; Priority matchmaking</li>
            <li>&#10003; Advanced stats dashboard</li>
            <li>&#10003; Match replay analysis</li>
            <li>&#10003; Custom profile badge</li>
            <li class="disabled">&#10007; Team management</li>
          </ul>
          <a href="/auth/register" class="btn btn-primary"><%- t('home.go_pro') %></a>
        </div>
        <div class="pricing-card">
          <div class="pricing-tier"><%- t('home.team') %></div>
          <div class="pricing-price">&#8364;29.99<span>/mo</span></div>
          <ul class="pricing-features">
            <li>&#10003; Everything in Pro</li>
            <li>&#10003; Team management (up to 10)</li>
            <li>&#10003; Private tournaments</li>
            <li>&#10003; API access</li>
            <li>&#10003; Team analytics</li>
            <li>&#10003; Dedicated support</li>
            <li>&#10003; Custom branding</li>
          </ul>
          <a href="/auth/register" class="btn btn-outline"><%- t('home.contact_sales') %></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark" id="testimonials">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title"><%- t('home.testimonials_title') %> <span class="accent"><%- t('home.testimonials_accent') %></span></h2>
        <p class="section-sub"><%- t('home.testimonials_sub') %></p>
      </div>
      <div class="testimonials-grid">
