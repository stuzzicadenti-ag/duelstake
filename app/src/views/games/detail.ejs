<%- include('../partials/head', { title: game.name }) %>
<%- include('../partials/nav') %>

<div class="container">
  <div class="page-header">
    <div class="flex items-center gap-2">
      <span style="font-size: 2.5rem;"><%= game.icon %></span>
      <div>
        <h1><%= game.name %></h1>
        <p><%= game.description %></p>
      </div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    <!-- Main content -->
    <div>
      <!-- Create/Join section -->
      <div class="card mb-3">
        <div class="flex items-center justify-between mb-2">
          <h2 style="font-size: 1.1rem; font-weight: 700;">Quick Match</h2>
          <span style="color: var(--accent); font-weight: 600;">&euro;<%= game.min_stake %> - &euro;<%= game.max_stake %></span>
        </div>
        <% if (user) { %>
          <a href="/matches/create?game=<%= game.slug %>" class="btn btn-primary" style="width: 100%; justify-content: center;">
            Create Match
          </a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-primary" style="width: 100%; justify-content: center;">
            Login to Create Match
          </a>
        <% } %>
      </div>

      <!-- Waiting matches -->
      <% if (waitingMatches.length > 0) { %>
      <div class="card mb-3">
        <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px;">Open Matches</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Player</th>
                <th>Stake</th>
                <th>Created</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% waitingMatches.forEach(function(m) { %>
              <tr>
                <td><a href="/profile/<%= m.player1_name %>"><%= m.player1_name %></a></td>
                <td style="color: var(--accent); font-weight: 700;">&euro;<%= parseFloat(m.stake_amount).toFixed(2) %></td>
                <td class="text-muted"><%= new Date(m.created_at).toLocaleString() %></td>
                <td>
                  <% if (user && user.id !== m.player1_id) { %>
                    <form action="/matches/<%= m.id %>/join" method="POST" style="display: inline;">
                      <button type="submit" class="btn btn-success btn-sm">Join</button>
                    </form>
                  <% } else if (!user) { %>
                    <a href="/auth/login" class="btn btn-outline btn-sm">Login to Join</a>
                  <% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

      <!-- Recent matches -->
      <div class="card">
        <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px;">Recent Matches</h2>
        <% if (recentMatches.length > 0) { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Players</th>
                <th>Stake</th>
                <th>Status</th>
                <th>Winner</th>
              </tr>
            </thead>
            <tbody>
              <% recentMatches.forEach(function(m) { %>
              <tr>
                <td>
                  <a href="/profile/<%= m.player1_name %>"><%= m.player1_name %></a>
                  <span class="text-muted"> vs </span>
                  <% if (m.player2_name) { %>
                    <a href="/profile/<%= m.player2_name %>"><%= m.player2_name %></a>
                  <% } else { %>
                    <span class="text-muted">Waiting...</span>
                  <% } %>
                </td>
                <td style="color: var(--accent); font-weight: 600;">&euro;<%= parseFloat(m.stake_amount).toFixed(2) %></td>
                <td><span class="badge badge-<%= m.status %>"><%= m.status %></span></td>
                <td>
                  <% if (m.winner_name) { %>
                    <a href="/profile/<%= m.winner_name %>" style="color: var(--success);"><%= m.winner_name %></a>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %>
          <p class="text-muted text-center" style="padding: 24px;">No matches yet. Be the first to create one!</p>
        <% } %>
      </div>
    </div>

    <!-- Sidebar -->
    <div>
      <div class="card">
        <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 16px;">Top Players</h3>
        <% if (topPlayers.length > 0) { %>
          <% topPlayers.forEach(function(p, i) { %>
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border);">
              <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-weight: 700; color: <%= i === 0 ? 'var(--accent)' : 'var(--text-muted)' %>; width: 20px;"><%= i + 1 %></span>
                <a href="/profile/<%= p.username %>"><%= p.display_name || p.username %></a>
              </div>
              <div style="text-align: right;">
                <div style="font-weight: 700; font-size: 0.9rem;"><%= p.elo %></div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">
                  <span style="color: var(--success);"><%= p.wins %>W</span> /
                  <span style="color: var(--danger);"><%= p.losses %>L</span>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-muted" style="font-size: 0.9rem;">No players ranked yet.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
