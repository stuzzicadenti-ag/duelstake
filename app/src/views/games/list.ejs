<%- include('../partials/head', { title: 'Games' }) %>
<%- include('../partials/nav') %>

<div class="container">
  <div class="page-header">
    <h1>Games</h1>
    <p>Choose your arena. Challenge opponents across multiple titles.</p>
  </div>

  <% if (games.length > 0) { %>
    <div class="grid grid-3 stagger-children">
      <% games.forEach(function(game) { %>
        <div class="card card-interactive game-card-v2">
          <div class="game-card-icon-wrap"><%= game.icon %></div>
          <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 8px;"><%= game.name %></h3>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 16px; line-height: 1.5;">
            <%= game.description %>
          </p>
          <div class="game-card-stats">
            <div class="game-card-stat-item">
              <div class="game-card-stat-value" style="color: var(--accent);">&euro;<%= game.min_stake %> - &euro;<%= game.max_stake %></div>
              <div class="game-card-stat-label">Stakes</div>
            </div>
            <div class="game-card-stat-item">
              <div class="game-card-stat-value" style="color: var(--success);"><%= game.player_count %></div>
              <div class="game-card-stat-label">Online</div>
            </div>
          </div>
          <div style="display: flex; gap: 8px;">
            <a href="/games/<%= game.slug %>" class="btn btn-secondary" style="flex: 1; justify-content: center;">Details</a>
            <a href="/matches/create?game=<%= game.slug %>" class="btn btn-primary" style="flex: 1; justify-content: center;">Find Match</a>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state animate-in">
      <div class="icon">&#127918;</div>
      <h2>No games available</h2>
      <p>No games available yet. Check back soon!</p>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
