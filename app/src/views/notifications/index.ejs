<%- include('../partials/head', { title: t('notifications.title') }) %>
<%- include('../partials/nav') %>

<div class="container">
  <div class="page-header flex items-center justify-between">
    <div>
      <h1><%= t('notifications.title') %></h1>
      <p><%= t('notifications.subtitle') %></p>
    </div>
    <% if (notifications.length > 0) { %>
      <form action="/notifications/mark-all-read" method="POST" style="margin: 0;">
        <button type="submit" class="btn btn-secondary btn-sm">Mark all read</button>
      </form>
    <% } %>
  </div>

  <div class="card animate-in">
    <% if (notifications.length > 0) { %>
      <div class="stagger-children">
        <% notifications.forEach(function(n) { %>
          <a href="<%= n.link || '#' %>" class="notif-item <%= !n.read ? 'unread' : '' %>">
            <div class="notif-icon <% if (n.type === 'match_result') { %>notif-icon-match<% } else if (n.type === 'achievement') { %>notif-icon-achievement<% } else if (n.type === 'match_invite') { %>notif-icon-invite<% } else if (n.type === 'dispute_update') { %>notif-icon-dispute<% } else { %>notif-icon-general<% } %>">
              <% if (n.type === 'match_result') { %>&#9876;<% } else if (n.type === 'achievement') { %>&#127942;<% } else if (n.type === 'match_invite') { %>&#9993;<% } else if (n.type === 'dispute_update') { %>&#9888;<% } else { %>&#128276;<% } %>
            </div>
            <div class="notif-content">
              <div class="notif-title-row">
                <span class="notif-title"><%= n.title %></span>
                <% if (!n.read) { %>
                  <span class="notif-dot"></span>
                <% } %>
              </div>
              <% if (n.message) { %>
                <div class="notif-message"><%= n.message %></div>
              <% } %>
              <div class="notif-time"><%= new Date(n.created_at).toLocaleString() %></div>
            </div>
            <div style="flex-shrink: 0;">
              <span class="badge" style="
                <% if (n.type === 'match_result') { %>
                  background: rgba(230, 57, 70, 0.12); color: var(--primary);
                <% } else if (n.type === 'achievement') { %>
                  background: rgba(255, 215, 0, 0.12); color: var(--accent);
                <% } else if (n.type === 'match_invite') { %>
                  background: rgba(96, 165, 250, 0.12); color: #60a5fa;
                <% } else if (n.type === 'dispute_update') { %>
                  background: rgba(239, 68, 68, 0.12); color: var(--danger);
                <% } else { %>
                  background: rgba(138, 138, 154, 0.12); color: var(--text-muted);
                <% } %>
              ">
                <% if (n.type === 'match_result') { %>
                  <%= t('notifications.type_match') %>
                <% } else if (n.type === 'achievement') { %>
                  <%= t('notifications.type_achievement') %>
                <% } else if (n.type === 'match_invite') { %>
                  <%= t('notifications.type_invite') %>
                <% } else if (n.type === 'dispute_update') { %>
                  <%= t('notifications.type_dispute') %>
                <% } else { %>
                  <%= t('notifications.type_general') %>
                <% } %>
              </span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state animate-in">
        <span class="icon">&#128276;</span>
        <h2><%= t('notifications.empty') %></h2>
        <p><%= t('notifications.empty_desc') %></p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
