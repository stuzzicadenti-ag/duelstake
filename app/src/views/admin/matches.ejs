<%- include('../partials/head', { title: 'Admin - Matches' }) %>
<%- include('../partials/nav') %>

<div class="admin-layout">
  <%- include('_sidebar', { activePage: 'matches' }) %>

  <div class="admin-content">
    <div style="margin-bottom: 24px;">
      <h1 style="font-size: 1.6rem; font-weight: 800;">Matches</h1>
      <p class="text-muted">View and manage all matches</p>
    </div>

    <!-- Status filter -->
    <div class="tabs mb-3">
      <a href="/admin/matches" class="tab <%= !statusFilter ? 'active' : '' %>">All</a>
      <a href="/admin/matches?status=waiting" class="tab <%= statusFilter === 'waiting' ? 'active' : '' %>">Waiting</a>
      <a href="/admin/matches?status=active" class="tab <%= statusFilter === 'active' ? 'active' : '' %>">Active</a>
      <a href="/admin/matches?status=disputed" class="tab <%= statusFilter === 'disputed' ? 'active' : '' %>">Disputed</a>
      <a href="/admin/matches?status=completed" class="tab <%= statusFilter === 'completed' ? 'active' : '' %>">Completed</a>
      <a href="/admin/matches?status=cancelled" class="tab <%= statusFilter === 'cancelled' ? 'active' : '' %>">Cancelled</a>
    </div>

    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Game</th>
              <th>Players</th>
              <th>Stake</th>
              <th>Status</th>
              <th>Winner</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (matches.length === 0) { %>
              <tr><td colspan="8" class="text-muted text-center" style="padding: 40px;">No matches found</td></tr>
            <% } else { %>
              <% matches.forEach(function(m) { %>
                <tr>
                  <td><a href="/matches/<%= m.id %>" style="font-weight: 600;">#<%= m.id %></a></td>
                  <td><%= m.game_icon %> <%= m.game_name %></td>
                  <td>
                    <a href="/profile/<%= m.player1_name %>"><%= m.player1_name %></a>
                    <span class="text-muted"> vs </span>
                    <% if (m.player2_name) { %>
                      <a href="/profile/<%= m.player2_name %>"><%= m.player2_name %></a>
                    <% } else { %>
                      <span class="text-muted">TBD</span>
                    <% } %>
                  </td>
                  <td style="color: var(--accent); font-weight: 700;">&euro;<%= parseFloat(m.stake_amount).toFixed(2) %></td>
                  <td><span class="badge badge-<%= m.status %>"><%= m.status %></span></td>
                  <td>
                    <% if (m.winner_name) { %>
                      <a href="/profile/<%= m.winner_name %>"><%= m.winner_name %></a>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td style="font-size: 0.85rem; color: var(--text-muted);"><%= new Date(m.created_at).toLocaleDateString() %></td>
                  <td>
                    <% if (m.status === 'disputed') { %>
                      <div style="display: flex; flex-direction: column; gap: 4px;">
                        <!-- Set winner -->
                        <form method="POST" action="/admin/matches/<%= m.id %>/resolve" style="display: flex; gap: 4px;">
                          <input type="hidden" name="action" value="set_winner">
                          <select name="winner_id" class="form-control" style="padding: 4px 6px; font-size: 0.75rem; width: auto;">
                            <option value="<%= m.player1_id %>"><%= m.player1_name %></option>
                            <% if (m.player2_id) { %>
                              <option value="<%= m.player2_id %>"><%= m.player2_name %></option>
                            <% } %>
                          </select>
                          <button type="submit" class="btn btn-sm btn-success" style="padding: 4px 8px; font-size: 0.7rem;">Winner</button>
                        </form>
                        <!-- Cancel with reason -->
                        <details>
                          <summary class="btn btn-sm btn-danger" style="padding: 4px 8px; font-size: 0.7rem; width: 100%; cursor: pointer; list-style: none; text-align: center;">Cancel & Refund</summary>
                          <form method="POST" action="/admin/matches/<%= m.id %>/resolve" style="margin-top: 8px; background: var(--bg); padding: 10px; border-radius: var(--radius); border: 1px solid var(--border);" onsubmit="return confirm('Cancel this match and refund both players?');">
                            <input type="hidden" name="action" value="cancel">
                            <div class="form-group" style="margin-bottom: 6px;">
                              <label style="font-size: 0.7rem;">Reason (required)</label>
                              <select name="cancel_reason" class="form-control" style="padding: 4px 8px; font-size: 0.8rem;" required>
                                <option value="cheating_confirmed">Cheating Confirmed</option>
                                <option value="bug_exploit">Bug / Exploit</option>
                                <option value="connection_issues">Connection Issues</option>
                                <option value="player_dispute">Player Dispute</option>
                                <option value="rule_violation">Rule Violation</option>
                                <option value="match_fixing">Match Fixing</option>
                                <option value="other">Other</option>
                              </select>
                            </div>
                            <div class="form-group" style="margin-bottom: 6px;">
                              <label style="font-size: 0.7rem;">Details</label>
                              <input type="text" name="cancel_details" class="form-control" style="padding: 4px 8px; font-size: 0.8rem;" placeholder="Optional details...">
                            </div>
                            <div class="form-group" style="margin-bottom: 6px;">
                              <label style="font-size: 0.7rem;">Evidence URL</label>
                              <input type="url" name="cancel_evidence_url" class="form-control" style="padding: 4px 8px; font-size: 0.8rem;" placeholder="https://...">
                            </div>
                            <div class="form-group" style="margin-bottom: 6px;">
                              <label style="font-size: 0.7rem;">Warn cheater (optional)</label>
                              <select name="warn_user_id" class="form-control" style="padding: 4px 8px; font-size: 0.8rem;">
                                <option value="">No warning</option>
                                <option value="<%= m.player1_id %>"><%= m.player1_name %></option>
                                <% if (m.player2_id) { %>
                                  <option value="<%= m.player2_id %>"><%= m.player2_name %></option>
                                <% } %>
                              </select>
                            </div>
                            <button type="submit" class="btn btn-sm btn-danger" style="width: 100%; font-size: 0.75rem;">Confirm Cancel</button>
                          </form>
                        </details>
                      </div>
                    <% } else if (m.status === 'waiting' || m.status === 'active' || m.status === 'proof_required') { %>
                      <details>
                        <summary class="btn btn-sm btn-outline" style="padding: 4px 8px; font-size: 0.7rem; cursor: pointer; list-style: none;">Cancel</summary>
                        <form method="POST" action="/admin/matches/<%= m.id %>/resolve" style="margin-top: 8px; background: var(--bg); padding: 10px; border-radius: var(--radius); border: 1px solid var(--border);" onsubmit="return confirm('Cancel and refund?');">
                          <input type="hidden" name="action" value="cancel">
                          <div class="form-group" style="margin-bottom: 6px;">
                            <label style="font-size: 0.7rem;">Reason</label>
                            <select name="cancel_reason" class="form-control" style="padding: 4px 8px; font-size: 0.8rem;" required>
                              <option value="cheating_confirmed">Cheating Confirmed</option>
                              <option value="bug_exploit">Bug / Exploit</option>
                              <option value="connection_issues">Connection Issues</option>
                              <option value="player_dispute">Player Dispute</option>
                              <option value="rule_violation">Rule Violation</option>
                              <option value="match_fixing">Match Fixing</option>
                              <option value="other">Other</option>
                            </select>
                          </div>
                          <div class="form-group" style="margin-bottom: 6px;">
                            <label style="font-size: 0.7rem;">Details</label>
                            <input type="text" name="cancel_details" class="form-control" style="padding: 4px 8px; font-size: 0.8rem;" placeholder="Optional...">
                          </div>
                          <button type="submit" class="btn btn-sm btn-danger" style="width: 100%; font-size: 0.75rem;">Confirm Cancel</button>
                        </form>
                      </details>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
