<%- include('../partials/head', { title: t('nav.signup') }) %>
<%- include('../partials/nav') %>

<div class="container" style="display: flex; justify-content: center; padding-top: 60px;">
  <div style="width: 100%; max-width: 420px;">
    <div style="text-align: center; margin-bottom: 32px;">
      <h1 style="font-size: 1.8rem; font-weight: 800;"><%- t('auth.join') %> <span style="color: var(--primary);">DuelStake</span></h1>
      <p class="text-muted"><%- t('auth.create_account_desc') %></p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="card">
      <form action="/auth/register" method="POST">
        <div class="form-group">
          <label><%= t('auth.username') %></label>
          <input type="text" name="username" class="form-control" placeholder="<%- t('auth.choose_username') %>" required minlength="3" maxlength="50" autofocus>
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;"><%- t('auth.username_hint') %></div>
        </div>
        <div class="form-group">
          <label><%- t('auth.display_name') %></label>
          <input type="text" name="display_name" class="form-control" placeholder="<%- t('auth.your_display_name') %>" maxlength="100">
        </div>
        <div class="form-group">
          <label><%= t('auth.email') %></label>
          <input type="email" name="email" class="form-control" placeholder="<%= t('auth.email_placeholder') %>" required>
        </div>
        <div class="form-group">
          <label><%= t('auth.password') %></label>
          <input type="password" name="password" class="form-control" placeholder="<%- t('auth.password_placeholder') %>" required minlength="8">
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; margin-top: 8px;">
          <%- t('auth.create_account') %>
        </button>
      </form>
    </div>

    <p style="text-align: center; margin-top: 20px; color: var(--text-muted); font-size: 0.9rem;">
      <%- t('auth.already_have') %> <a href="/auth/login"><%- t('auth.sign_in') %></a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
