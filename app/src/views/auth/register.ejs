<%- include('../partials/head', { title: 'Sign Up' }) %>
<%- include('../partials/nav') %>

<div class="container" style="display: flex; justify-content: center; padding-top: 60px;">
  <div style="width: 100%; max-width: 420px;">
    <div style="text-align: center; margin-bottom: 32px;">
      <h1 style="font-size: 1.8rem; font-weight: 800;">Join <span style="color: var(--primary);">DuelStake</span></h1>
      <p class="text-muted">Create your account and start competing.</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="card">
      <form action="/auth/register" method="POST">
        <div class="form-group">
          <label>Username</label>
          <input type="text" name="username" class="form-control" placeholder="Choose a username" required minlength="3" maxlength="50" autofocus>
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">3-50 characters. This is your public identity.</div>
        </div>
        <div class="form-group">
          <label>Display Name (optional)</label>
          <input type="text" name="display_name" class="form-control" placeholder="Your display name" maxlength="100">
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" class="form-control" placeholder="Min 8 characters" required minlength="8">
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px; margin-top: 8px;">
          Create Account
        </button>
      </form>
    </div>

    <p style="text-align: center; margin-top: 20px; color: var(--text-muted); font-size: 0.9rem;">
      Already have an account? <a href="/auth/login">Sign In</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
