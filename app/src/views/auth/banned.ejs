<%- include('../partials/head', { title: 'Account Suspended' }) %>
<%- include('../partials/nav') %>

<div class="container" style="display: flex; justify-content: center; padding-top: 60px;">
  <div style="width: 100%; max-width: 520px; text-align: center;">
    <div style="font-size: 4rem; margin-bottom: 16px;">&#128683;</div>
    <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--danger); margin-bottom: 12px;">Account Suspended</h1>
    <p class="text-muted" style="margin-bottom: 24px;">
      Your DuelStake account has been suspended for violating our platform rules.
    </p>

    <div class="card" style="text-align: left; margin-bottom: 24px;">
      <% if (typeof reason !== 'undefined' && reason) { %>
        <div style="margin-bottom: 16px;">
          <div style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Reason</div>
          <div style="color: var(--danger); font-weight: 500;"><%= reason %></div>
        </div>
      <% } %>
      <% if (typeof bannedAt !== 'undefined' && bannedAt) { %>
        <div style="margin-bottom: 16px;">
          <div style="font-size: 0.8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">Suspended On</div>
          <div><%= new Date(bannedAt).toLocaleString() %></div>
        </div>
      <% } %>
    </div>

    <div class="card" style="text-align: left;">
      <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 12px;">What can I do?</h3>
      <ul style="list-style: disc; padding-left: 20px; color: var(--text-muted); font-size: 0.9rem; line-height: 2;">
        <li>Review our <a href="/faq">FAQ & Rules</a> to understand what led to the suspension</li>
        <li>If you believe this was a mistake, contact our support team</li>
        <li>Provide any relevant evidence to support your appeal</li>
      </ul>
    </div>

    <div style="margin-top: 24px; padding: 20px; background: var(--surface); border-radius: var(--radius); border: 1px solid var(--border);">
      <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">Contact Support</div>
      <a href="mailto:support@duelstake.ch" style="font-weight: 700; font-size: 1.1rem;">support@duelstake.ch</a>
    </div>

    <p style="margin-top: 24px;">
      <a href="/" class="btn btn-outline">Back to Home</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
