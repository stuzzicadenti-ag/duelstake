<%- include('../partials/head', { title: 'Match #' + match.id }) %>
<%- include('../partials/nav') %>

<div class="container">
  <div class="page-header">
    <div class="flex items-center gap-2">
      <span style="font-size: 2rem;"><%= match.game_icon %></span>
      <div>
        <h1>Match #<%= match.id %></h1>
        <p><%= match.game_name %> &mdash; <span class="badge badge-<%= match.status %>"><%= match.status %></span></p>
      </div>
    </div>
  </div>

  <!-- Players & Stake -->
  <div class="card mb-3">
    <div style="display: flex; align-items: center; gap: 20px; justify-content: center; flex-wrap: wrap;">
      <div style="text-align: center; flex: 1; min-width: 150px;">
        <div style="width: 64px; height: 64px; background: var(--surface-2); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0 auto 8px; border: 2px solid <%= match.winner_id === match.player1_id ? 'var(--success)' : 'var(--border)' %>;">
          &#128100;
        </div>
        <a href="/profile/<%= match.player1_name %>" style="font-weight: 700; font-size: 1.1rem;">
          <%= match.player1_display || match.player1_name %>
        </a>
        <div style="font-size: 0.85rem; color: var(--text-muted);">ELO: <%= match.player1_elo %></div>
        <% if (match.winner_id === match.player1_id) { %>
          <div style="color: var(--success); font-weight: 700; margin-top: 4px;">WINNER</div>
        <% } %>
      </div>

      <div style="text-align: center;">
        <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Stake</div>
        <div style="font-size: 2rem; font-weight: 900; color: var(--accent); margin: 4px 0;">
          &euro;<%= parseFloat(match.stake_amount).toFixed(2) %>
        </div>
        <div style="font-size: 0.8rem; color: var(--text-muted);">each (&euro;<%= (parseFloat(match.stake_amount) * 2).toFixed(2) %> pot)</div>
        <div style="font-size: 1.5rem; color: var(--text-muted); margin-top: 8px;">VS</div>
      </div>

      <div style="text-align: center; flex: 1; min-width: 150px;">
        <% if (match.player2_name) { %>
          <div style="width: 64px; height: 64px; background: var(--surface-2); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0 auto 8px; border: 2px solid <%= match.winner_id === match.player2_id ? 'var(--success)' : 'var(--border)' %>;">
            &#128100;
          </div>
          <a href="/profile/<%= match.player2_name %>" style="font-weight: 700; font-size: 1.1rem;">
            <%= match.player2_display || match.player2_name %>
          </a>
          <div style="font-size: 0.85rem; color: var(--text-muted);">ELO: <%= match.player2_elo %></div>
          <% if (match.winner_id === match.player2_id) { %>
            <div style="color: var(--success); font-weight: 700; margin-top: 4px;">WINNER</div>
          <% } %>
        <% } else { %>
          <div style="width: 64px; height: 64px; background: var(--surface-2); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin: 0 auto 8px; border: 2px dashed var(--border);">
            ?
          </div>
          <div style="font-weight: 700; font-size: 1.1rem; color: var(--text-muted);">Waiting for opponent</div>
        <% } %>
      </div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
    <!-- Timeline -->
    <div class="card">
      <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 16px;">Timeline</h2>
      <div style="border-left: 2px solid var(--border); padding-left: 20px;">
        <div style="margin-bottom: 16px; position: relative;">
          <div style="position: absolute; left: -27px; top: 4px; width: 12px; height: 12px; background: var(--success); border-radius: 50%;"></div>
          <div style="font-weight: 600;">Match Created</div>
          <div style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(match.created_at).toLocaleString() %></div>
        </div>
        <% if (match.started_at) { %>
        <div style="margin-bottom: 16px; position: relative;">
          <div style="position: absolute; left: -27px; top: 4px; width: 12px; height: 12px; background: var(--primary); border-radius: 50%;"></div>
          <div style="font-weight: 600;">Match Started</div>
          <div style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(match.started_at).toLocaleString() %></div>
        </div>
        <% } %>
        <% if (match.completed_at) { %>
        <div style="margin-bottom: 16px; position: relative;">
          <div style="position: absolute; left: -27px; top: 4px; width: 12px; height: 12px; background: var(--accent); border-radius: 50%;"></div>
          <div style="font-weight: 600;">Match Completed</div>
          <div style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(match.completed_at).toLocaleString() %></div>
        </div>
        <% } %>
        <% if (match.status === 'disputed') { %>
        <div style="position: relative;">
          <div style="position: absolute; left: -27px; top: 4px; width: 12px; height: 12px; background: var(--danger); border-radius: 50%;"></div>
          <div style="font-weight: 600; color: var(--danger);">Disputed</div>
          <div style="font-size: 0.8rem; color: var(--text-muted);">Awaiting admin review</div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Actions / Proofs -->
    <div>
      <% if (typeof user !== 'undefined' && user && match.status === 'waiting' && match.player1_id !== user.id) { %>
        <div class="card mb-2">
          <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 12px;">Join This Match</h2>
          <p class="text-muted mb-2" style="font-size: 0.9rem;">
            Stake &euro;<%= parseFloat(match.stake_amount).toFixed(2) %> to join. Winner takes &euro;<%= (parseFloat(match.stake_amount) * 2).toFixed(2) %>.
          </p>
          <form action="/matches/<%= match.id %>/join" method="POST">
            <button type="submit" class="btn btn-success" style="width: 100%; justify-content: center;">
              Join Match (&euro;<%= parseFloat(match.stake_amount).toFixed(2) %>)
            </button>
          </form>
        </div>
      <% } %>

      <% if (typeof user !== 'undefined' && user && (match.status === 'active' || match.status === 'proof_required') && (match.player1_id === user.id || match.player2_id === user.id)) { %>
        <!-- Upload Proof -->
        <div class="card mb-2">
          <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 12px;">Submit Proof</h2>
          <form action="/matches/<%= match.id %>/proof" method="POST" enctype="multipart/form-data">
            <div class="form-group">
              <label>Screenshot / Video</label>
              <input type="file" name="file" accept="image/*,video/*" class="form-control" required
                     style="padding: 8px;">
            </div>
            <div class="form-group">
              <label>Description (optional)</label>
              <input type="text" name="description" class="form-control" placeholder="e.g. Final score 3-1">
            </div>
            <button type="submit" class="btn btn-secondary" style="width: 100%; justify-content: center;">Upload Proof</button>
          </form>
        </div>

        <!-- Report Winner -->
        <div class="card">
          <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 12px;">Report Winner</h2>
          <p class="text-muted mb-2" style="font-size: 0.85rem;">
            Both players must agree on the winner. If you claim yourself, the match will be disputed.
          </p>
          <form action="/matches/<%= match.id %>/report" method="POST" style="display: flex; gap: 8px;">
            <input type="hidden" name="winner_id" value="<%= match.player1_id === user.id ? match.player2_id : match.player1_id %>">
            <button type="submit" class="btn btn-success" style="flex: 1; justify-content: center;">
              I Lost (Opponent Wins)
            </button>
          </form>
          <form action="/matches/<%= match.id %>/report" method="POST" style="margin-top: 8px;">
            <input type="hidden" name="winner_id" value="<%= user.id %>">
            <button type="submit" class="btn btn-danger" style="width: 100%; justify-content: center;">
              I Won (Dispute if opponent disagrees)
            </button>
          </form>
        </div>
      <% } %>

      <!-- Proofs submitted -->
      <% if (proofs.length > 0) { %>
        <div class="card mt-2">
          <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 12px;">Submitted Proofs</h2>
          <% proofs.forEach(function(p) { %>
            <div style="padding: 10px 0; border-bottom: 1px solid var(--border);">
              <div class="flex items-center justify-between">
                <span style="font-weight: 600;"><%= p.username %></span>
                <span class="badge badge-<%= p.review_status === 'pending' ? 'waiting' : p.review_status === 'approved' ? 'active' : 'disputed' %>">
                  <%= p.review_status %>
                </span>
              </div>
              <% if (p.description) { %>
                <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;"><%= p.description %></div>
              <% } %>
              <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 2px;"><%= new Date(p.submitted_at).toLocaleString() %></div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
