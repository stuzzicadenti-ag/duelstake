<%- include('../partials/head', { title: 'My Matches' }) %>
<%- include('../partials/nav') %>

<div class="container">
  <div class="page-header flex items-center justify-between">
    <div>
      <h1>My Matches</h1>
      <p>Track your active duels and match history.</p>
    </div>
    <a href="/matches/create" class="btn btn-primary">Create Match</a>
  </div>

  <!-- Tabs -->
  <div class="tabs">
    <a href="/matches?tab=active" class="tab <%= tab === 'active' ? 'active' : '' %>">
      Active
      <% if (tab === 'active' && matches.length > 0) { %>
        <span style="background: var(--primary); color: #fff; font-size: 0.65rem; font-weight: 700; padding: 1px 6px; border-radius: 10px; margin-left: 4px;"><%= matches.length %></span>
      <% } %>
    </a>
    <a href="/matches?tab=completed" class="tab <%= tab === 'completed' ? 'active' : '' %>">Completed</a>
    <a href="/matches?tab=disputed" class="tab <%= tab === 'disputed' ? 'active' : '' %>">Disputed</a>
  </div>

  <% if (matches.length > 0) { %>
    <div class="grid grid-2 stagger-children">
      <% matches.forEach(function(m) { %>
        <a href="/matches/<%= m.id %>" class="card card-interactive match-card-v2">
          <div class="match-card-header">
            <div class="match-card-game">
              <span class="match-card-game-icon"><%= m.game_icon %></span>
              <span class="match-card-game-name"><%= m.game_name %></span>
            </div>
            <span class="badge badge-<%= m.status %>"><%= m.status %></span>
          </div>
          <div class="match-card-players">
            <div class="match-card-player">
              <div class="match-card-player-name"><%= m.player1_name %></div>
              <div class="match-card-player-label">Challenger</div>
            </div>
            <div style="display: flex; flex-direction: column; align-items: center; gap: 8px; flex-shrink: 0;">
              <div class="vs-badge" style="width: 36px; height: 36px; font-size: 0.7rem;">VS</div>
              <div class="match-card-stake">
                <div class="match-card-stake-amount">&euro;<%= parseFloat(m.stake_amount).toFixed(2) %></div>
                <div class="match-card-stake-label">Stake</div>
              </div>
            </div>
            <div class="match-card-player">
              <% if (m.player2_name) { %>
                <div class="match-card-player-name"><%= m.player2_name %></div>
                <div class="match-card-player-label">Opponent</div>
              <% } else { %>
                <div class="match-card-player-name" style="color: var(--text-muted);">Waiting...</div>
                <div class="match-card-player-label" style="animation: pulse 2s infinite;">Open Spot</div>
              <% } %>
            </div>
          </div>
          <div class="match-card-footer">
            <% if (m.winner_name) { %>
              <span class="match-card-winner">&#127942; Winner: <%= m.winner_name %></span>
            <% } else { %>
              <span></span>
            <% } %>
            <span class="match-card-date"><%= new Date(m.created_at).toLocaleDateString() %></span>
          </div>
        </a>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state animate-in">
      <div class="icon">&#9876;</div>
      <h2>No <%= tab %> matches</h2>
      <p>No <%= tab %> matches found. Ready to compete?</p>
      <a href="/games" class="btn btn-primary">Find a Game</a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
