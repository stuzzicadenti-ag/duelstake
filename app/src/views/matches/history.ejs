<%- include('../partials/head', { title: t('match_history.title') }) %>
<%- include('../partials/nav') %>

<div class="container">
  <div class="page-header">
    <h1><%= t('match_history.title') %></h1>
    <p><%= t('match_history.subtitle') %></p>
  </div>

  <!-- Filters -->
  <div class="card mb-3 animate-in">
    <form method="GET" action="/matches/history" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
      <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 140px;">
        <label><%= t('match_history.game') %></label>
        <select name="game" class="form-control">
          <option value=""><%= t('match_history.all_games') %></option>
          <% games.forEach(function(g) { %>
            <option value="<%= g.id %>" <%= gameFilter == g.id ? 'selected' : '' %>><%= g.icon %> <%= g.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 140px;">
        <label><%= t('match_history.result') %></label>
        <select name="result" class="form-control">
          <option value=""><%= t('match_history.all_results') %></option>
          <option value="won" <%= resultFilter === 'won' ? 'selected' : '' %>><%= t('match_history.won') %></option>
          <option value="lost" <%= resultFilter === 'lost' ? 'selected' : '' %>><%= t('match_history.lost') %></option>
        </select>
      </div>
      <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 140px;">
        <label><%= t('match_history.date_from') %></label>
        <input type="date" name="from" class="form-control" value="<%= dateFrom %>">
      </div>
      <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 140px;">
        <label><%= t('match_history.date_to') %></label>
        <input type="date" name="to" class="form-control" value="<%= dateTo %>">
      </div>
      <button type="submit" class="btn btn-primary btn-sm"><%= t('match_history.filter') %></button>
    </form>
  </div>

  <!-- Results -->
  <div class="card animate-in" style="animation-delay: 0.1s;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
      <h2 style="font-size: 1.1rem; font-weight: 700;"><%= t('match_history.results') %> (<%= totalCount %>)</h2>
    </div>

    <% if (matches.length > 0) { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th><%= t('match_history.game') %></th>
              <th><%= t('match_history.opponent') %></th>
              <th><%= t('match_history.stake') %></th>
              <th><%= t('match_history.result') %></th>
              <th><%= t('match_history.elo_change') %></th>
              <th><%= t('match_history.date') %></th>
            </tr>
          </thead>
          <tbody>
            <% matches.forEach(function(m) { %>
              <%
                var isWin = m.winner_name === user.username;
                var opponent = m.player1_name === user.username ? m.player2_name : m.player1_name;
                var eloChange = m.elo_change != null ? parseInt(m.elo_change) : null;
              %>
              <tr>
                <td>
                  <a href="/games/<%= m.game_slug %>" style="display: flex; align-items: center; gap: 6px;">
                    <span><%= m.game_icon %></span> <%= m.game_name %>
                  </a>
                </td>
                <td>
                  <a href="/profile/<%= opponent %>"><%= opponent %></a>
                </td>
                <td style="color: var(--accent); font-weight: 600;">&euro;<%= parseFloat(m.stake_amount).toFixed(2) %></td>
                <td>
                  <span class="badge" style="background: rgba(<%= isWin ? '34,197,94' : '239,68,68' %>, 0.15); color: var(<%= isWin ? '--success' : '--danger' %>);">
                    <%= isWin ? t('match_history.won') : t('match_history.lost') %>
                  </span>
                </td>
                <td style="font-weight: 600; color: var(<%= eloChange != null && eloChange >= 0 ? '--success' : '--danger' %>);">
                  <% if (eloChange != null) { %>
                    <%= eloChange >= 0 ? '+' : '' %><%= eloChange %>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td style="font-size: 0.85rem; color: var(--text-muted);">
                  <%= m.completed_at ? new Date(m.completed_at).toLocaleDateString() : '-' %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <div style="display: flex; justify-content: center; gap: 8px; margin-top: 20px; flex-wrap: wrap;">
          <% if (page > 1) { %>
            <a href="/matches/history?page=<%= page - 1 %>&game=<%= gameFilter %>&result=<%= resultFilter %>&from=<%= dateFrom %>&to=<%= dateTo %>" class="btn btn-sm btn-secondary">&laquo; <%= t('match_history.prev') %></a>
          <% } %>
          <span style="display: flex; align-items: center; padding: 0 12px; font-size: 0.85rem; color: var(--text-muted);">
            <%= t('match_history.page') %> <%= page %> / <%= totalPages %>
          </span>
          <% if (page < totalPages) { %>
            <a href="/matches/history?page=<%= page + 1 %>&game=<%= gameFilter %>&result=<%= resultFilter %>&from=<%= dateFrom %>&to=<%= dateTo %>" class="btn btn-sm btn-secondary"><%= t('match_history.next') %> &raquo;</a>
          <% } %>
        </div>
      <% } %>
    <% } else { %>
      <div class="empty-state">
        <span class="icon">&#128203;</span>
        <h2><%= t('match_history.no_matches') %></h2>
        <p><%= t('match_history.no_matches_desc') %></p>
        <a href="/matches/create" class="btn btn-primary"><%= t('match_history.create_match') %></a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
