<%- include('../partials/head', { title: 'Wallet' }) %>
<%- include('../partials/nav') %>

<div class="container">
  <div class="page-header">
    <h1>Wallet</h1>
    <p>Manage your balance, deposits and withdrawals.</p>
  </div>

  <% if (error === 'insufficient') { %>
    <div class="alert alert-error"><span class="alert-icon">&#9888;</span> Insufficient balance. Withdraw amount cannot exceed your current balance.</div>
  <% } else if (error === 'invalid_amount') { %>
    <div class="alert alert-error"><span class="alert-icon">&#9888;</span> Invalid amount. Please enter a valid number.</div>
  <% } else if (error === 'no_funds') { %>
    <div class="alert alert-error"><span class="alert-icon">&#9888;</span> No funds available to withdraw.</div>
  <% } else if (error === 'kyc_limit') { %>
    <div class="alert alert-error"><span class="alert-icon">&#9888;</span> Unverified accounts are limited to &euro;100/day withdrawals. <a href="/profile/verify" style="color: var(--accent); text-decoration: underline;">Verify your identity</a> to remove limits.</div>
  <% } %>
  <% if (success === 'deposit') { %>
    <div class="alert alert-success"><span class="alert-icon">&#10003;</span> Deposit successful!</div>
  <% } else if (success === 'withdraw') { %>
    <div class="alert alert-success"><span class="alert-icon">&#10003;</span> Withdrawal successful!</div>
  <% } %>

  <!-- Balance display -->
  <div class="card wallet-balance-card mb-3 animate-in">
    <div style="font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600;">Available Balance</div>
    <div class="wallet-balance-amount">
      &euro;<%= parseFloat(balance).toFixed(2) %>
    </div>
    <div style="font-size: 0.85rem; color: var(--text-muted);">Mock balance, no real payments in MVP</div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;" class="wallet-grid">
    <!-- Deposit -->
    <div class="card animate-in" style="animation-delay: 0.05s;">
      <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 16px; color: var(--success); display: flex; align-items: center; gap: 6px;">
        <span>&#8593;</span> Deposit
      </h2>
      <form action="/wallet/deposit" method="POST">
        <div class="form-group">
          <label for="deposit-amount">Amount (&euro;)</label>
          <input type="number" name="amount" id="deposit-amount" class="form-control" step="0.01" min="1" max="10000" placeholder="50.00" required>
        </div>
        <div style="display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap;">
          <button type="button" class="btn btn-secondary btn-sm" onclick="this.form.amount.value='10'">&euro;10</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="this.form.amount.value='25'">&euro;25</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="this.form.amount.value='50'">&euro;50</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="this.form.amount.value='100'">&euro;100</button>
          <button type="button" class="btn btn-secondary btn-sm" onclick="this.form.amount.value='500'">&euro;500</button>
        </div>
        <button type="submit" class="btn btn-success" style="width: 100%; justify-content: center;" onclick="this.classList.add('btn-loading');">Deposit</button>
      </form>
    </div>

    <!-- Withdraw -->
    <div class="card animate-in" style="animation-delay: 0.1s;">
      <h2 style="font-size: 1rem; font-weight: 700; margin-bottom: 16px; color: var(--primary); display: flex; align-items: center; gap: 6px;">
        <span>&#8595;</span> Withdraw
      </h2>
      <% if (parseFloat(balance) <= 0) { %>
        <div style="text-align: center; padding: 32px 16px; color: var(--text-muted);">
          <div style="font-size: 2rem; margin-bottom: 12px; opacity: 0.5;">&#128176;</div>
          <p>No funds available to withdraw</p>
        </div>
      <% } else { %>
        <form action="/wallet/withdraw" method="POST">
          <div class="form-group">
            <label for="withdraw-amount">Amount (&euro;)</label>
            <input type="number" name="amount" id="withdraw-amount" class="form-control" step="0.01" min="1" max="<%= parseFloat(balance).toFixed(2) %>" placeholder="25.00" required>
          </div>
          <button type="button" class="btn btn-secondary btn-sm mb-2" onclick="this.form.amount.value='<%= parseFloat(balance).toFixed(2) %>'">Withdraw All</button>
          <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;" onclick="this.classList.add('btn-loading');">Withdraw</button>
        </form>
      <% } %>
    </div>
  </div>

  <!-- KYC Banner -->
  <% if (kycStatus !== 'verified') { %>
    <div class="alert mb-3 animate-in" style="background: rgba(255, 215, 0, 0.08); border: 1px solid rgba(255, 215, 0, 0.3); color: var(--accent); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; animation-delay: 0.15s;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 1.3rem;">&#128274;</span>
        <div>
          <strong>Identity not verified.</strong>
          <div style="font-size: 0.85rem; opacity: 0.8;">Unverified accounts are limited to &euro;100/day withdrawals and &euro;50/match stakes.</div>
        </div>
      </div>
      <a href="/profile/verify" class="btn btn-sm btn-accent">Verify Now</a>
    </div>
  <% } %>

  <!-- Billing Summary -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 16px; margin-bottom: 32px;" class="stagger-children">
    <div class="card stat-card-v2">
      <div class="stat-v2-value text-success" style="font-size: 1.4rem;">&euro;<%= (totalsByType.deposit || 0).toFixed(2) %></div>
      <div class="stat-v2-label">Total Deposits</div>
    </div>
    <div class="card stat-card-v2">
      <div class="stat-v2-value text-danger" style="font-size: 1.4rem;">&euro;<%= (totalsByType.withdrawal || 0).toFixed(2) %></div>
      <div class="stat-v2-label">Total Withdrawals</div>
    </div>
    <div class="card stat-card-v2">
      <div class="stat-v2-value text-accent" style="font-size: 1.4rem;">&euro;<%= (totalsByType.win || 0).toFixed(2) %></div>
      <div class="stat-v2-label">Total Winnings</div>
    </div>
    <div class="card stat-card-v2">
      <div class="stat-v2-value" style="font-size: 1.4rem; color: #60a5fa;">&euro;<%= (totalsByType.stake || 0).toFixed(2) %></div>
      <div class="stat-v2-label">Total Staked</div>
    </div>
  </div>

  <!-- Payment Methods -->
  <div class="card mb-3 animate-in" style="animation-delay: 0.2s;">
    <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 6px;">
      <span>&#128179;</span> Payment Methods
    </h2>
    <div style="display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--bg); border-radius: var(--radius); border: 1px solid var(--border);">
      <div style="width: 48px; height: 32px; background: linear-gradient(135deg, #1a1f71, #00579f); border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 0.65rem; font-weight: 700;">VISA</div>
      <div style="flex: 1;">
        <div style="font-weight: 600;">Visa ending in ****1234</div>
        <div style="font-size: 0.8rem; color: var(--text-muted);">Expires 12/28</div>
      </div>
      <span class="badge badge-active">Default</span>
    </div>
    <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 12px;">Payment integration coming soon. Currently using mock deposits.</p>
  </div>

  <!-- Transaction history -->
  <div class="card animate-in" style="animation-delay: 0.25s;">
    <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 6px;">
      <span>&#128203;</span> Transaction History
    </h2>
    <% if (transactions.length > 0) { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Type</th>
              <th>Amount</th>
              <th>Description</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.forEach(function(tx) { %>
            <tr>
              <td>
                <span class="badge badge-<%= tx.type === 'deposit' || tx.type === 'win' || tx.type === 'refund' ? 'active' : tx.type === 'stake' ? 'waiting' : 'disputed' %>">
                  <%= tx.type %>
                </span>
              </td>
              <td style="font-weight: 700; color: <%= parseFloat(tx.amount) >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
                <%= parseFloat(tx.amount) >= 0 ? '+' : '' %>&euro;<%= parseFloat(tx.amount).toFixed(2) %>
              </td>
              <td class="text-muted"><%= tx.description || '-' %></td>
              <td class="text-muted"><%= new Date(tx.created_at).toLocaleString() %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state" style="padding: 40px;">
        <span class="icon" style="font-size: 2.5rem;">&#128176;</span>
        <p>No transactions yet. Make a deposit to get started!</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
