  </div><!-- /.main-content -->
  <footer class="app-footer">
    <div class="container">
      <div style="display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 12px;">
        <span style="color: #a78bfa; font-size: 1.1rem;">&#9876;</span>
        <span style="font-weight: 700; color: var(--text);">Duel<span style="background: linear-gradient(135deg, #a78bfa, #60a5fa, #22d3ee); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Stake</span></span>
      </div>
      <div style="display: flex; justify-content: center; gap: 24px; margin-bottom: 16px; flex-wrap: wrap;">
        <a href="/games"><%= t('footer.games') %></a>
        <a href="/leaderboard"><%= t('footer.leaderboard') %></a>
        <a href="/matches"><%= t('footer.matches') %></a>
        <a href="/faq"><%- t('footer.faq') %></a>
        <a href="#"><%- t('footer.terms') %></a>
        <a href="#"><%- t('footer.privacy') %></a>
      </div>
      <p><%- t('footer.rights') %></p>
      <p style="margin-top: 8px; font-size: 0.75rem; max-width: 700px; margin-left: auto; margin-right: auto; line-height: 1.6;">
        <%- t('footer.legal') %>
      </p>
    </div>
  </footer>

  <!-- Toast container for JS notifications -->
  <div class="toast-container" id="toastContainer"></div>

  <script>
  // Form loading states
  document.querySelectorAll('form').forEach(function(form) {
    form.addEventListener('submit', function() {
      var btn = form.querySelector('button[type="submit"]');
      if (btn && !btn.classList.contains('btn-loading')) {
        // Small delay so the browser sends the form first
        setTimeout(function() { btn.classList.add('btn-loading'); }, 50);
      }
    });
  });

  // Auto-dismiss alerts after 5 seconds
  document.querySelectorAll('.alert-success').forEach(function(alert) {
    setTimeout(function() {
      alert.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
      alert.style.opacity = '0';
      alert.style.transform = 'translateY(-10px)';
      setTimeout(function() { alert.remove(); }, 300);
    }, 5000);
  });
  </script>
</body>
</html>
