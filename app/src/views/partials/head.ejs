<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | DuelStake' : 'DuelStake' %></title>
  <meta name="description" content="DuelStake - The competitive gaming matchmaking platform for 1v1 duels, tournaments, and ranked ladders.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title + ' | DuelStake' : 'DuelStake' %>">
  <meta property="og:description" content="Find opponents, set stakes, and prove your skill on DuelStake.">
  <meta property="og:site_name" content="DuelStake">
  <meta property="og:image" content="/public/favicon.svg">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title + ' | DuelStake' : 'DuelStake' %>">
  <meta name="twitter:description" content="Find opponents, set stakes, and prove your skill on DuelStake.">
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0a0a0f;
      --surface: rgba(22, 22, 31, 0.7);
      --surface-solid: #16161f;
      --surface-2: #1c1c28;
      --primary: #e63946;
      --primary-hover: #ff6b6b;
      --accent: #ffd700;
      --text: #f0f0f5;
      --text-muted: #8a8a9a;
      --border: rgba(255, 255, 255, 0.08);
      --border-glow: rgba(139, 92, 246, 0.3);
      --success: #22c55e;
      --danger: #ef4444;
      --radius: 12px;
      --glow: rgba(230, 57, 70, 0.3);
      --neon-purple: #8b5cf6;
      --neon-blue: #3b82f6;
      --neon-cyan: #06b6d4;
      --gradient-gaming: linear-gradient(135deg, #8b5cf6, #3b82f6, #06b6d4);
      --gradient-gaming-text: linear-gradient(135deg, #a78bfa, #60a5fa, #22d3ee);
      --glass-bg: rgba(22, 22, 31, 0.6);
      --glass-border: rgba(255, 255, 255, 0.06);
      --glass-blur: blur(20px);
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.6;
      display: flex;
      flex-direction: column;
      background-image:
        radial-gradient(ellipse 80% 50% at 50% -20%, rgba(139, 92, 246, 0.08), transparent),
        radial-gradient(ellipse 60% 40% at 80% 50%, rgba(59, 130, 246, 0.04), transparent);
    }
    .main-content {
      flex: 1;
    }
    a { color: var(--neon-purple); text-decoration: none; transition: color 0.2s; }
    a:hover { color: #a78bfa; }
    ul { list-style: none; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

    /* Nav */
    nav {
      background: rgba(10, 10, 15, 0.8);
      backdrop-filter: blur(20px) saturate(180%);
      border-bottom: 1px solid var(--glass-border);
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    nav .nav-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 60px;
      gap: 24px;
    }
    nav .logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.5px;
      text-decoration: none;
      flex-shrink: 0;
    }
    nav .logo span { background: var(--gradient-gaming-text); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

    /* Hamburger toggle - CSS only */
    .nav-toggle-checkbox { display: none; }
    .nav-toggle-label {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 8px;
      z-index: 1001;
    }
    .nav-toggle-label span {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--text);
      border-radius: 2px;
      transition: all 0.3s ease;
    }
    .nav-toggle-checkbox:checked ~ .nav-toggle-label span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }
    .nav-toggle-checkbox:checked ~ .nav-toggle-label span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle-checkbox:checked ~ .nav-toggle-label span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    nav .nav-links { display: flex; align-items: center; gap: 6px; }
    nav .nav-links a {
      color: var(--text-muted);
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.2s, background 0.2s;
      padding: 6px 12px;
      border-radius: 6px;
      white-space: nowrap;
    }
    nav .nav-links a:hover { color: var(--text); background: rgba(255,255,255,0.04); }
    nav .nav-links a.active { color: var(--neon-purple); text-shadow: 0 0 8px rgba(139, 92, 246, 0.3); }
    .nav-group { display: flex; align-items: center; gap: 4px; }
    .nav-group--right { margin-left: auto; }
    .nav-divider {
      width: 1px;
      height: 20px;
      background: var(--border);
      margin: 0 4px;
      flex-shrink: 0;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 24px;
      font-size: 0.9375rem;
      font-weight: 600;
      border-radius: var(--radius);
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      white-space: nowrap;
      line-height: 1.4;
      font-family: inherit;
    }
    .btn:active { transform: scale(0.98); }
    .btn-primary {
      background: linear-gradient(135deg, #8b5cf6, #3b82f6);
      color: #fff;
      box-shadow: 0 4px 16px rgba(139, 92, 246, 0.3);
      position: relative;
      overflow: hidden;
    }
    .btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
      opacity: 0;
      transition: opacity 0.3s;
    }
    .btn-primary:hover::before { opacity: 1; }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(139, 92, 246, 0.5), 0 0 20px rgba(59, 130, 246, 0.2); color: #fff; }
    .btn-secondary {
      background: rgba(255, 255, 255, 0.04);
      color: var(--text);
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(8px);
    }
    .btn-secondary:hover { border-color: var(--neon-purple); color: var(--neon-purple); box-shadow: 0 0 12px rgba(139, 92, 246, 0.15); }
    .btn-accent {
      background: var(--accent);
      color: #000;
    }
    .btn-accent:hover { background: #e6c200; color: #000; }
    .btn-success {
      background: var(--success);
      color: #fff;
    }
    .btn-success:hover { background: #16a34a; }
    .btn-danger {
      background: var(--danger);
      color: #fff;
    }
    .btn-danger:hover { background: #dc2626; }
    .btn-sm { padding: 6px 14px; font-size: 0.8rem; }
    .btn-outline {
      background: transparent;
      color: var(--text);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .btn-outline:hover { border-color: var(--neon-cyan); color: var(--neon-cyan); box-shadow: 0 0 16px rgba(6, 182, 212, 0.15); }

    /* File upload */
    .file-upload {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 20px;
      background: var(--surface-2);
      border: 2px dashed var(--border);
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-weight: 500;
      color: var(--text-muted);
      font-size: 0.9rem;
      width: 100%;
    }
    .file-upload:hover { border-color: var(--primary); color: var(--text); }
    .file-upload input[type="file"] {
      position: absolute; inset: 0; opacity: 0; cursor: pointer;
    }

    /* Cards - Glassmorphism */
    .card {
      background: var(--glass-bg);
      backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      padding: 24px;
      transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
      box-shadow: 0 4px 24px rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.03);
      position: relative;
    }
    .card:hover { border-color: rgba(139, 92, 246, 0.3); box-shadow: 0 8px 32px rgba(0,0,0,0.3), 0 0 20px rgba(139, 92, 246, 0.08); }
    .card-glow:hover { box-shadow: 0 0 30px rgba(139, 92, 246, 0.2), 0 8px 32px rgba(0,0,0,0.3); }

    /* Forms */
    .form-group { margin-bottom: 16px; }
    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .form-control {
      width: 100%;
      padding: 10px 14px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--text);
      font-size: 0.95rem;
      font-family: inherit;
      transition: border-color 0.2s;
    }
    .form-control:focus {
      outline: none;
      border-color: var(--neon-purple);
      box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15), 0 0 12px rgba(139, 92, 246, 0.08);
    }
    textarea.form-control { resize: vertical; min-height: 80px; }
    .form-control::placeholder { color: var(--text-muted); }
    select.form-control { cursor: pointer; }

    /* Tables */
    .table-wrap { overflow-x: auto; }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 12px 16px;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }
    th {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    tr:hover td { background: rgba(139, 92, 246, 0.03); }

    /* Badges - Neon style */
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      border: 1px solid transparent;
    }
    .badge-waiting { background: rgba(255, 215, 0, 0.1); color: var(--accent); border-color: rgba(255, 215, 0, 0.2); box-shadow: 0 0 8px rgba(255, 215, 0, 0.1); }
    .badge-active { background: rgba(34, 197, 94, 0.1); color: var(--success); border-color: rgba(34, 197, 94, 0.2); box-shadow: 0 0 8px rgba(34, 197, 94, 0.1); }
    .badge-completed { background: rgba(96, 165, 250, 0.1); color: #60a5fa; border-color: rgba(96, 165, 250, 0.2); box-shadow: 0 0 8px rgba(96, 165, 250, 0.1); }
    .badge-disputed { background: rgba(239, 68, 68, 0.1); color: var(--danger); border-color: rgba(239, 68, 68, 0.2); box-shadow: 0 0 8px rgba(239, 68, 68, 0.1); }
    .badge-cancelled { background: rgba(138, 138, 154, 0.08); color: var(--text-muted); border-color: rgba(138, 138, 154, 0.15); }

    /* Alerts */
    .alert {
      padding: 12px 16px;
      border-radius: var(--radius);
      margin-bottom: 16px;
      font-size: 0.9rem;
    }
    .alert-error {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid var(--danger);
      color: var(--danger);
    }
    .alert-success {
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid var(--success);
      color: var(--success);
    }

    /* Tabs */
    .tabs {
      display: flex;
      gap: 4px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      margin-bottom: 24px;
    }
    .tab {
      padding: 12px 20px;
      color: var(--text-muted);
      font-weight: 500;
      font-size: 0.9rem;
      border-bottom: 2px solid transparent;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
      position: relative;
    }
    .tab:hover { color: var(--text); }
    .tab.active {
      color: var(--neon-purple);
      border-bottom-color: var(--neon-purple);
      text-shadow: 0 0 12px rgba(139, 92, 246, 0.3);
    }

    /* Grid */
    .grid { display: grid; gap: 20px; }
    .grid-2 { grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
    .grid-3 { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }

    /* Utils */
    .text-center { text-align: center; }
    .text-muted { color: var(--text-muted); }
    .text-primary { color: var(--primary); }
    .text-accent { color: var(--accent); }
    .text-success { color: var(--success); }
    .text-danger { color: var(--danger); }
    .mb-1 { margin-bottom: 8px; }
    .mb-2 { margin-bottom: 16px; }
    .mb-3 { margin-bottom: 24px; }
    .mb-4 { margin-bottom: 32px; }
    .mt-2 { margin-top: 16px; }
    .mt-3 { margin-top: 24px; }
    .flex { display: flex; }
    .items-center { align-items: center; }
    .justify-between { justify-content: space-between; }
    .gap-2 { gap: 16px; }
    .gap-1 { gap: 8px; }

    /* Page header */
    .page-header {
      padding: 48px 0 40px;
    }
    .page-header h1 {
      font-size: 2.2rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      background: var(--gradient-gaming-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .page-header p {
      color: var(--text-muted);
      margin-top: 8px;
      font-size: 1.05rem;
    }

    /* Stat cards */
    .stat {
      text-align: center;
      padding: 20px;
    }
    .stat-value {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1;
    }
    .stat-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-top: 6px;
    }

    /* Typography hierarchy */
    h1 { font-size: 2rem; font-weight: 800; letter-spacing: -0.5px; line-height: 1.2; }
    h2 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.3px; line-height: 1.3; }
    h3 { font-size: 1.125rem; font-weight: 700; line-height: 1.4; }

    /* Empty state */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-muted);
    }
    .empty-state .icon {
      font-size: 3.5rem;
      margin-bottom: 16px;
      opacity: 0.6;
      display: block;
    }
    .empty-state p { margin-bottom: 16px; font-size: 1rem; }
    .empty-state h2 { color: var(--text); margin-bottom: 8px; font-size: 1.25rem; }

    /* Footer */
    footer {
      background: rgba(10, 10, 15, 0.8);
      backdrop-filter: blur(12px);
      border-top: 1px solid var(--glass-border);
      padding: 32px 0;
      margin-top: auto;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
    }
    footer a { color: var(--text-muted); }
    footer a:hover { color: var(--neon-purple); }

    /* Responsive: Tablet & below */
    @media (max-width: 1024px) {
      nav .nav-links { gap: 12px; }
      nav .nav-links a { font-size: 0.85rem; padding: 6px 10px; }
      .grid-2 { grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
    }

    @media (max-width: 768px) {
      .nav-toggle-label { display: flex; }
      nav .nav-links {
        display: none;
        position: absolute;
        top: 60px;
        left: 0;
        right: 0;
        background: rgba(10, 10, 15, 0.98);
        backdrop-filter: blur(12px);
        flex-direction: column;
        padding: 16px 24px;
        gap: 4px;
        border-bottom: 1px solid var(--border);
        box-shadow: 0 8px 24px rgba(0,0,0,0.3);
        z-index: 999;
      }
      .nav-toggle-checkbox:checked ~ .nav-links { display: flex; }
      nav .nav-links a {
        padding: 10px 12px;
        font-size: 0.9rem;
        width: 100%;
        border-radius: 6px;
      }
      nav .nav-links a:hover { background: rgba(255,255,255,0.05); }
      .nav-group { flex-direction: column; width: 100%; gap: 2px; }
      .nav-group--right { margin-left: 0; }
      .nav-divider {
        width: 100%;
        height: 1px;
        margin: 6px 0;
      }
      /* Dropdowns: inline on mobile */
      .nav-dropdown { width: 100%; }
      .nav-dropdown .nav-dropdown-btn { width: 100%; justify-content: flex-start; }
      .nav-dropdown-menu {
        position: static;
        box-shadow: none;
        border: none;
        background: rgba(255,255,255,0.02);
        border-radius: 6px;
        padding: 2px 0;
        margin-top: 2px;
      }
      /* Profile dropdown hidden on mobile, items shown inline */
      .profile-dropdown { display: none; }
      .mobile-profile-section { display: block; width: 100%; }
      .mobile-divider { display: block; }
      /* Lang dropdown on mobile */
      .lang-dropdown { width: 100%; }
      .lang-dropdown .nav-dropdown-menu { min-width: unset; }
      .grid-3, .grid-2 { grid-template-columns: 1fr; }
      .page-header h1 { font-size: 1.5rem; }
      .page-header .flex { flex-direction: column; align-items: flex-start !important; gap: 12px; }
      .hide-mobile { display: none; }
      .container { padding: 0 16px; }
    }

    @media (max-width: 768px) {
      .match-detail-grid { grid-template-columns: 1fr !important; }
    }

    @media (max-width: 480px) {
      h1 { font-size: 1.5rem; }
      h2 { font-size: 1.25rem; }
      .btn { padding: 10px 18px; font-size: 0.875rem; }
      .btn-sm { padding: 6px 12px; font-size: 0.75rem; }
      .card { padding: 16px; }
      .page-header { padding: 24px 0; }
    }

    @media (max-width: 320px) {
      .container { padding: 0 12px; }
      nav { padding: 0 12px; }
      .card { padding: 12px; }
      h1 { font-size: 1.3rem; }
    }

    /* Ultra-wide */
    @media (min-width: 1440px) {
      .container { max-width: 1320px; }
    }
    @media (min-width: 2560px) {
      .container { max-width: 1600px; }
      body { font-size: 1.05rem; }
    }
    /* Dropdowns (language + profile) */
    .nav-dropdown {
      position: relative;
    }
    .nav-dropdown-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--text-muted);
      font-size: 0.9rem;
      font-weight: 500;
      padding: 6px 12px;
      border-radius: 6px;
      cursor: pointer;
      transition: color 0.2s, background 0.2s;
      background: none;
      border: none;
      font-family: inherit;
      white-space: nowrap;
    }
    .nav-dropdown-btn:hover { color: var(--text); background: rgba(255,255,255,0.04); }
    .nav-dropdown-btn .caret {
      font-size: 0.6rem;
      transition: transform 0.2s;
    }
    .nav-dropdown.open .nav-dropdown-btn .caret { transform: rotate(180deg); }
    .nav-dropdown-menu {
      display: none;
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      min-width: 180px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 6px 0;
      box-shadow: 0 8px 24px rgba(0,0,0,0.4);
      z-index: 1100;
    }
    .nav-dropdown.open .nav-dropdown-menu { display: block; }
    .nav-dropdown-menu a,
    .nav-dropdown-menu button {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 9px 16px;
      color: var(--text-muted);
      font-size: 0.875rem;
      font-weight: 500;
      transition: color 0.2s, background 0.2s;
      text-decoration: none;
      border: none;
      background: none;
      cursor: pointer;
      font-family: inherit;
      text-align: left;
    }
    .nav-dropdown-menu a:hover,
    .nav-dropdown-menu button:hover {
      color: var(--text);
      background: rgba(255,255,255,0.04);
    }
    .nav-dropdown-menu .dropdown-divider {
      height: 1px;
      background: var(--border);
      margin: 6px 0;
    }
    .nav-dropdown-menu .dropdown-header {
      padding: 8px 16px 4px;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .nav-dropdown-menu a.active { color: var(--primary); }
    .nav-dropdown-menu a.text-accent { color: var(--accent); }
    .nav-dropdown-menu a.text-accent:hover { color: var(--accent); background: rgba(255,215,0,0.06); }
    .nav-dropdown-menu a.text-danger { color: var(--danger); }
    .nav-dropdown-menu a.text-danger:hover { color: var(--danger); background: rgba(239,68,68,0.06); }

    /* Language dropdown */
    .lang-dropdown .nav-dropdown-btn {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      padding: 5px 10px;
    }
    .lang-dropdown .nav-dropdown-menu {
      min-width: 100px;
    }
    .lang-dropdown .nav-dropdown-menu a {
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.3px;
      padding: 7px 16px;
    }

    /* Profile dropdown */
    .profile-dropdown .nav-dropdown-btn {
      gap: 6px;
    }
    .profile-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: rgba(139, 92, 246, 0.12);
      border: 2px solid rgba(139, 92, 246, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--neon-purple);
      flex-shrink: 0;
    }

    /* Mobile: dropdown items inline in menu */
    .mobile-profile-section { display: none; }
    .mobile-divider { display: none; }

    /* === ANIMATIONS & TRANSITIONS === */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideInLeft {
      from { opacity: 0; transform: translateX(-20px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.9); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes glowPulse {
      0%, 100% { box-shadow: 0 0 8px rgba(139, 92, 246, 0.15); }
      50% { box-shadow: 0 0 24px rgba(139, 92, 246, 0.35); }
    }

    .animate-in { animation: fadeInUp 0.4s ease-out both; }
    .animate-fade { animation: fadeIn 0.3s ease-out both; }
    .animate-slide { animation: slideInLeft 0.4s ease-out both; }
    .animate-scale { animation: scaleIn 0.3s ease-out both; }

    /* Stagger children animations */
    .stagger-children > * { animation: fadeInUp 0.4s ease-out both; }
    .stagger-children > *:nth-child(1) { animation-delay: 0.05s; }
    .stagger-children > *:nth-child(2) { animation-delay: 0.1s; }
    .stagger-children > *:nth-child(3) { animation-delay: 0.15s; }
    .stagger-children > *:nth-child(4) { animation-delay: 0.2s; }
    .stagger-children > *:nth-child(5) { animation-delay: 0.25s; }
    .stagger-children > *:nth-child(6) { animation-delay: 0.3s; }
    .stagger-children > *:nth-child(7) { animation-delay: 0.35s; }
    .stagger-children > *:nth-child(8) { animation-delay: 0.4s; }

    /* === IMPROVED CARD STYLES === */
    .card {
      transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    }
    .card-interactive {
      cursor: pointer;
    }
    .card-interactive:hover {
      transform: translateY(-4px) perspective(1000px) rotateX(1deg);
      border-color: rgba(139, 92, 246, 0.4);
      box-shadow: 0 12px 40px rgba(139, 92, 246, 0.12), 0 0 20px rgba(139, 92, 246, 0.06), 0 4px 12px rgba(0,0,0,0.3);
    }

    /* === MATCH CARD IMPROVEMENTS === */
    .match-card-v2 {
      position: relative;
      overflow: hidden;
      text-decoration: none;
      color: var(--text);
      display: block;
    }
    .match-card-v2::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--gradient-gaming);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .match-card-v2:hover::before {
      opacity: 1;
    }
    .match-card-v2::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius);
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.03), transparent, rgba(6, 182, 212, 0.02));
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .match-card-v2:hover::after {
      opacity: 1;
    }
    .match-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
    }
    .match-card-game {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .match-card-game-icon {
      font-size: 1.5rem;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(6, 182, 212, 0.05));
      border-radius: 12px;
      border: 1px solid rgba(139, 92, 246, 0.1);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .match-card-v2:hover .match-card-game-icon {
      transform: scale(1.05);
      box-shadow: 0 0 12px rgba(139, 92, 246, 0.15);
    }
    .match-card-game-name {
      font-weight: 700;
      font-size: 1rem;
    }
    .match-card-players {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .match-card-player {
      flex: 1;
      text-align: center;
    }
    .match-card-player-name {
      font-weight: 700;
      font-size: 0.95rem;
    }
    .match-card-player-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-top: 2px;
    }
    .match-card-stake {
      padding: 10px 20px;
      background: var(--bg);
      border-radius: var(--radius);
      text-align: center;
      flex-shrink: 0;
    }
    .match-card-stake-amount {
      background: var(--gradient-gaming-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 900;
      font-size: 1.2rem;
    }
    .match-card-stake-label {
      font-size: 0.7rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .match-card-vs {
      font-size: 0.85rem;
      font-weight: 800;
      background: var(--gradient-gaming-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 2px;
    }
    .match-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 12px;
    }
    .match-card-winner {
      color: var(--success);
      font-weight: 600;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .match-card-date {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* === GAME CARD IMPROVEMENTS === */
    .game-card-v2 {
      position: relative;
      overflow: hidden;
    }
    .game-card-v2::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--gradient-gaming);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }
    .game-card-v2:hover::after {
      transform: scaleX(1);
    }
    .game-card-icon-wrap {
      width: 64px;
      height: 64px;
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(6, 182, 212, 0.05));
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
      margin-bottom: 16px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .game-card-v2:hover .game-card-icon-wrap {
      transform: scale(1.1);
      box-shadow: 0 0 20px rgba(139, 92, 246, 0.15);
    }
    .game-card-stats {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      margin-bottom: 16px;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .game-card-stat-item {
      text-align: center;
    }
    .game-card-stat-value {
      font-weight: 700;
      font-size: 0.95rem;
    }
    .game-card-stat-label {
      font-size: 0.7rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* === LEADERBOARD IMPROVEMENTS === */
    .lb-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }
    .lb-table tr {
      transition: background 0.2s ease;
    }
    .lb-table tbody tr:hover {
      background: linear-gradient(90deg, rgba(139, 92, 246, 0.04), rgba(59, 130, 246, 0.02), transparent);
    }
    .lb-rank-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      font-weight: 800;
      font-size: 0.85rem;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .lb-rank-badge:hover { transform: scale(1.1); }
    .lb-rank-1 {
      background: linear-gradient(135deg, rgba(255, 215, 0, 0.25), rgba(255, 170, 0, 0.15));
      color: #ffd700;
      box-shadow: 0 0 16px rgba(255, 215, 0, 0.3);
      animation: goldShimmer 3s ease-in-out infinite;
    }
    @keyframes goldShimmer {
      0%, 100% { box-shadow: 0 0 12px rgba(255, 215, 0, 0.2); }
      50% { box-shadow: 0 0 24px rgba(255, 215, 0, 0.45), 0 0 8px rgba(255, 170, 0, 0.3); }
    }
    .lb-rank-2 {
      background: rgba(192, 192, 192, 0.12);
      color: #c0c0c0;
      box-shadow: 0 0 8px rgba(192, 192, 192, 0.1);
    }
    .lb-rank-3 {
      background: rgba(205, 127, 50, 0.12);
      color: #cd7f32;
      box-shadow: 0 0 8px rgba(205, 127, 50, 0.1);
    }
    .lb-rank-default {
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-muted);
    }
    .lb-player-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .lb-player-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(139, 92, 246, 0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.8rem;
      color: var(--neon-purple);
      flex-shrink: 0;
      border: 2px solid rgba(139, 92, 246, 0.2);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    tr:hover .lb-player-avatar { transform: scale(1.05); }
    .lb-elo-bar {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .lb-elo-fill {
      height: 6px;
      background: var(--gradient-gaming);
      border-radius: 3px;
      transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 0 6px rgba(139, 92, 246, 0.3);
    }

    /* === NOTIFICATION IMPROVEMENTS === */
    .notif-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 16px;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      color: var(--text);
      transition: background 0.2s ease;
      border-radius: var(--radius);
      margin-bottom: 4px;
    }
    .notif-item:hover {
      background: var(--surface-2);
    }
    .notif-item.unread {
      background: rgba(139, 92, 246, 0.03);
      border-left: 3px solid var(--neon-purple);
    }
    .notif-icon {
      flex-shrink: 0;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }
    .notif-icon-match { background: rgba(230, 57, 70, 0.12); color: var(--primary); }
    .notif-icon-achievement { background: rgba(255, 215, 0, 0.12); color: var(--accent); }
    .notif-icon-invite { background: rgba(96, 165, 250, 0.12); color: #60a5fa; }
    .notif-icon-dispute { background: rgba(239, 68, 68, 0.12); color: var(--danger); }
    .notif-icon-general { background: rgba(138, 138, 154, 0.12); color: var(--text-muted); }
    .notif-content { flex: 1; min-width: 0; }
    .notif-title-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 3px;
    }
    .notif-title { font-weight: 700; font-size: 0.9rem; }
    .notif-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--neon-purple);
      flex-shrink: 0;
      animation: notifPulse 2s ease-in-out infinite;
      box-shadow: 0 0 8px rgba(139, 92, 246, 0.5);
    }
    @keyframes notifPulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(139, 92, 246, 0.5); }
      50% { opacity: 0.6; box-shadow: 0 0 16px rgba(139, 92, 246, 0.8); }
    }
    .notif-message { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 3px; }
    .notif-time { font-size: 0.75rem; color: var(--text-muted); }

    /* === PROFILE IMPROVEMENTS === */
    .profile-hero {
      display: flex;
      align-items: center;
      gap: 24px;
      padding: 36px;
      background: linear-gradient(135deg, var(--glass-bg), rgba(139, 92, 246, 0.03));
      backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      border-radius: 16px;
      margin-bottom: 24px;
      position: relative;
      overflow: hidden;
    }
    .profile-hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--gradient-gaming);
      background-size: 200% 100%;
      animation: shimmer 3s linear infinite;
    }
    .profile-hero::after {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(139, 92, 246, 0.06), transparent 70%);
      pointer-events: none;
    }
    .profile-avatar-lg {
      width: 92px;
      height: 92px;
      background: var(--gradient-gaming);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
      flex-shrink: 0;
      box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3), 0 0 24px rgba(59, 130, 246, 0.15);
      position: relative;
      z-index: 1;
    }
    .profile-info h1 { margin-bottom: 4px; }
    .profile-info p { color: var(--text-muted); font-size: 0.95rem; }
    .profile-badges {
      display: flex;
      gap: 8px;
      margin-top: 8px;
      flex-wrap: wrap;
    }
    .profile-badge-item {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 12px;
      background: rgba(139, 92, 246, 0.08);
      border: 1px solid rgba(139, 92, 246, 0.2);
      border-radius: 20px;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--neon-purple);
      letter-spacing: 0.3px;
    }

    /* === STAT CARD IMPROVEMENTS === */
    .stat-card-v2 {
      text-align: center;
      padding: 28px 16px;
      position: relative;
      overflow: hidden;
    }
    .stat-card-v2::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--gradient-gaming);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .stat-card-v2:hover::before {
      opacity: 1;
    }
    .stat-card-v2:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(139, 92, 246, 0.12);
    }
    .stat-v2-value {
      font-size: 2.2rem;
      font-weight: 900;
      line-height: 1.1;
      margin-bottom: 8px;
      font-variant-numeric: tabular-nums;
    }
    .stat-v2-label {
      font-size: 0.7rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 600;
    }

    /* === LOADING STATES === */
    .skeleton {
      background: linear-gradient(90deg, rgba(22,22,31,0.8) 25%, rgba(139,92,246,0.06) 50%, rgba(22,22,31,0.8) 75%);
      background-size: 200% 100%;
      animation: shimmer 1.5s infinite;
      border-radius: var(--radius);
    }
    .skeleton-text {
      height: 14px;
      margin-bottom: 8px;
      border-radius: 4px;
    }
    .skeleton-title {
      height: 24px;
      width: 60%;
      margin-bottom: 12px;
      border-radius: 4px;
    }
    .skeleton-circle {
      border-radius: 50%;
    }

    /* Loading spinner */
    .spinner {
      width: 24px;
      height: 24px;
      border: 3px solid var(--border);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    .btn-loading {
      position: relative;
      color: transparent !important;
      pointer-events: none;
    }
    .btn-loading::after {
      content: '';
      position: absolute;
      width: 18px;
      height: 18px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }

    /* === TOAST NOTIFICATIONS === */
    .toast-container {
      position: fixed;
      top: 80px;
      right: 24px;
      z-index: 2000;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .toast {
      padding: 14px 20px;
      border-radius: var(--radius);
      font-size: 0.9rem;
      font-weight: 500;
      min-width: 280px;
      max-width: 400px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.3);
      animation: slideInToast 0.3s ease-out;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .toast-success {
      background: rgba(34, 197, 94, 0.15);
      border: 1px solid var(--success);
      color: var(--success);
    }
    .toast-error {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid var(--danger);
      color: var(--danger);
    }
    .toast-info {
      background: rgba(96, 165, 250, 0.15);
      border: 1px solid #60a5fa;
      color: #60a5fa;
    }
    @keyframes slideInToast {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }

    /* === IMPROVED ALERT STYLES === */
    .alert {
      display: flex;
      align-items: center;
      gap: 10px;
      animation: fadeInUp 0.3s ease-out;
    }
    .alert-icon {
      flex-shrink: 0;
      font-size: 1.1rem;
    }

    /* === WALLET IMPROVEMENTS === */
    .wallet-balance-card {
      text-align: center;
      padding: 56px 24px;
      background: linear-gradient(135deg, var(--glass-bg), rgba(139, 92, 246, 0.04), rgba(6, 182, 212, 0.02));
      backdrop-filter: var(--glass-blur);
      position: relative;
      overflow: hidden;
      border-radius: 16px;
    }
    .wallet-balance-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--gradient-gaming);
      background-size: 200% 100%;
      animation: shimmer 4s linear infinite;
    }
    .wallet-balance-card::after {
      content: '';
      position: absolute;
      top: -100px;
      left: 50%;
      transform: translateX(-50%);
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(139, 92, 246, 0.06), transparent 60%);
      pointer-events: none;
    }
    .wallet-balance-amount {
      font-size: 4rem;
      font-weight: 900;
      background: var(--gradient-gaming-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1;
      margin: 16px 0;
      letter-spacing: -2px;
      position: relative;
      z-index: 1;
    }

    /* === TIMELINE IMPROVEMENTS === */
    .timeline {
      position: relative;
      padding-left: 24px;
    }
    .timeline::before {
      content: '';
      position: absolute;
      left: 7px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(to bottom, var(--neon-purple), var(--neon-blue), rgba(255,255,255,0.05));
    }
    .timeline-item {
      position: relative;
      margin-bottom: 20px;
      padding-left: 12px;
    }
    .timeline-dot {
      position: absolute;
      left: -20px;
      top: 4px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 2px solid var(--bg);
    }
    .timeline-dot-success { background: var(--success); box-shadow: 0 0 8px rgba(34, 197, 94, 0.3); }
    .timeline-dot-primary { background: var(--primary); box-shadow: 0 0 8px rgba(230, 57, 70, 0.3); }
    .timeline-dot-accent { background: var(--accent); box-shadow: 0 0 8px rgba(255, 215, 0, 0.3); }
    .timeline-dot-danger { background: var(--danger); box-shadow: 0 0 8px rgba(239, 68, 68, 0.3); }
    .timeline-label { font-weight: 600; font-size: 0.95rem; }
    .timeline-date { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }

    /* === VS BADGE === */
    .vs-badge {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--gradient-gaming);
      color: #fff;
      font-weight: 900;
      font-size: 0.85rem;
      letter-spacing: 2px;
      flex-shrink: 0;
      box-shadow: 0 4px 16px rgba(139, 92, 246, 0.4), 0 0 24px rgba(59, 130, 246, 0.2);
      animation: vsPulse 2.5s ease-in-out infinite;
      position: relative;
    }
    .vs-badge::after {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      background: var(--gradient-gaming);
      z-index: -1;
      opacity: 0.3;
      filter: blur(8px);
    }
    @keyframes vsPulse {
      0%, 100% { box-shadow: 0 4px 16px rgba(139, 92, 246, 0.4), 0 0 24px rgba(59, 130, 246, 0.2); }
      50% { box-shadow: 0 4px 24px rgba(139, 92, 246, 0.6), 0 0 40px rgba(59, 130, 246, 0.3); }
    }

    /* === RESPONSIVE GRID FIX FOR WALLET === */
    @media (max-width: 768px) {
      .wallet-grid { grid-template-columns: 1fr !important; }
      .profile-hero { flex-direction: column; text-align: center; }
      .profile-hero .profile-badges { justify-content: center; }
      .stats-2col { grid-template-columns: 1fr !important; }
    }
    @media (max-width: 480px) {
      .match-card-players { flex-direction: column; gap: 8px; }
      .match-card-stake { width: 100%; }
      .toast-container { right: 12px; left: 12px; }
      .toast { min-width: 0; width: 100%; }
      .profile-avatar-lg { width: 64px; height: 64px; font-size: 1.6rem; }
    }

    /* === NEON UTILITIES === */
    .text-gradient {
      background: var(--gradient-gaming-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .neon-border {
      border: 1px solid rgba(139, 92, 246, 0.2);
      box-shadow: 0 0 12px rgba(139, 92, 246, 0.08);
    }
    .neon-border:hover {
      border-color: rgba(139, 92, 246, 0.4);
      box-shadow: 0 0 24px rgba(139, 92, 246, 0.15);
    }

    /* Animated counter for stat values */
    .stat-v2-value, .wallet-balance-amount {
      transition: transform 0.3s ease;
    }
    .stat-v2-value:hover {
      transform: scale(1.05);
    }

    /* Card tilt effect on hover (subtle perspective) */
    .card-tilt {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .card-tilt:hover {
      transform: perspective(800px) rotateY(2deg) rotateX(1deg) translateY(-4px);
    }

    /* Win/loss color utilities */
    .win-glow { color: var(--success); text-shadow: 0 0 8px rgba(34, 197, 94, 0.3); }
    .loss-glow { color: var(--danger); text-shadow: 0 0 8px rgba(239, 68, 68, 0.3); }

    /* Neon button glow on hover for all buttons */
    .btn { position: relative; overflow: hidden; }
    .btn::after {
      content: '';
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }
    .btn-success::after { background: radial-gradient(circle at center, rgba(34,197,94,0.15), transparent 70%); }
    .btn-danger::after { background: radial-gradient(circle at center, rgba(239,68,68,0.15), transparent 70%); }
    .btn:hover::after { opacity: 1; }

    /* Section headings with gradient */
    .card h2 span:first-child {
      filter: drop-shadow(0 0 4px currentColor);
    }

    /* Smooth entrance for page content */
    .main-content {
      animation: fadeIn 0.3s ease-out;
