<nav class="app-nav">
  <div class="nav-inner">
    <a href="/" class="logo"><span class="logo-sword">&#9876;</span> Duel<span class="red">Stake</span></a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" aria-label="Toggle navigation">
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>
    <div class="nav-links">
      <a href="/games"><%= t('nav.games') %></a>
      <a href="/leaderboard"><%= t('nav.leaderboard') %></a>
      <a href="/faq"><%= t('nav.faq') %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/matches"><%= t('nav.matches') %></a>
        <a href="/wallet"><%= t('nav.wallet') %></a>
        <% if (typeof user.role !== 'undefined' && (user.role === 'admin' || user.role === 'owner')) { %>
          <a href="/admin" style="color: var(--accent);"><%= t('nav.admin') %></a>
        <% } %>
        <a href="/profile/<%= user.username %>" class="hide-mobile"><%= user.display_name || user.username %></a>
        <a href="/auth/logout" class="btn btn-outline btn-sm"><%= t('nav.logout') %></a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-secondary btn-sm"><%= t('nav.login') %></a>
        <a href="/auth/register" class="btn btn-primary btn-sm"><%= t('nav.signup') %></a>
      <% } %>
      <span class="lang-switcher">
        <a href="/lang/en" class="lang-link<%= lang === 'en' ? ' active' : '' %>">EN</a>
        <a href="/lang/it" class="lang-link<%= lang === 'it' ? ' active' : '' %>">IT</a>
        <a href="/lang/de" class="lang-link<%= lang === 'de' ? ' active' : '' %>">DE</a>
        <a href="/lang/fr" class="lang-link<%= lang === 'fr' ? ' active' : '' %>">FR</a>
      </span>
    </div>
  </div>
</nav>
